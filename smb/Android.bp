license {
    name: "twrp_infiniti_smb2_license",
    license_kinds: ["SPDX-license-identifier-LGPL-2.1"],
    license_text: ["upstream/LICENCE-LGPL-2.1.txt"],
}

cc_library_shared {
    name: "libtwrp_smb2",
    licenses: ["twrp_infiniti_smb2_license"],
    recovery: true,
    compile_multilib: "64",
    srcs: [
        "upstream/lib/aes.c",
        "upstream/lib/aes_reference.c",
        "upstream/lib/aes128ccm.c",
        "upstream/lib/aes-armv8.c",
        "upstream/lib/alloc.c",
        "upstream/lib/asn1-ber.c",
        "upstream/lib/compat.c",
        "upstream/lib/errors.c",
        "upstream/lib/hmac.c",
        "upstream/lib/hmac-md5.c",
        "upstream/lib/init.c",
        "upstream/lib/krb5-wrapper.c",
        "upstream/lib/libsmb2.c",
        "upstream/lib/md4c.c",
        "upstream/lib/md5.c",
        "upstream/lib/ntlmssp.c",
        "upstream/lib/pdu.c",
        "upstream/lib/quic.c",
        "upstream/lib/smbdirect.c",
        "upstream/lib/sha1.c",
        "upstream/lib/sha224-256.c",
        "upstream/lib/sha384-512.c",
        "upstream/lib/smb2-cmd-cancel.c",
        "upstream/lib/smb2-cmd-close.c",
        "upstream/lib/smb2-cmd-create.c",
        "upstream/lib/smb2-cmd-echo.c",
        "upstream/lib/smb2-cmd-error.c",
        "upstream/lib/smb2-cmd-flush.c",
        "upstream/lib/smb2-cmd-ioctl.c",
        "upstream/lib/smb2-cmd-lock.c",
        "upstream/lib/smb2-cmd-logoff.c",
        "upstream/lib/smb2-cmd-negotiate.c",
        "upstream/lib/smb2-cmd-notify-change.c",
        "upstream/lib/smb2-cmd-oplock-break.c",
        "upstream/lib/smb2-cmd-query-directory.c",
        "upstream/lib/smb2-cmd-query-info.c",
        "upstream/lib/smb2-cmd-read.c",
        "upstream/lib/smb2-cmd-session-setup.c",
        "upstream/lib/smb2-cmd-set-info.c",
        "upstream/lib/smb2-cmd-tree-connect.c",
        "upstream/lib/smb2-cmd-tree-disconnect.c",
        "upstream/lib/smb2-cmd-write.c",
        "upstream/lib/smb2-data-file-info.c",
        "upstream/lib/smb2-data-filesystem-info.c",
        "upstream/lib/smb2-data-security-descriptor.c",
        "upstream/lib/smb2-data-reparse-point.c",
        "upstream/lib/smb2-share-enum.c",
        "upstream/lib/smb3-seal.c",
        "upstream/lib/smb2-signing.c",
        "upstream/lib/socket.c",
        "upstream/lib/spnego-wrapper.c",
        "upstream/lib/sync.c",
        "upstream/lib/timestamps.c",
        "upstream/lib/unicode.c",
        "upstream/lib/usha.c",
        "upstream/lib/aes_apple.c",
    ],
    export_include_dirs: ["upstream/include"],
    local_include_dirs: [".", "upstream/lib", "upstream/include", "upstream/include/smb2"],
    cflags: ["-DHAVE_CONFIG_H", "-D_FILE_OFFSET_BITS=64", "-Wno-error"],
}

cc_binary {
    name: "twrp-smb-client",
    recovery: true,
    compile_multilib: "64",
    srcs: ["client.cpp"],
    shared_libs: ["libtwrp_smb2", "libfuse", "libcrypto"],
    cflags: ["-Wall", "-Wextra"],
    stl: "libc++_static",
}
