diff --git a/payload_consumer/partition_update_generator_android.cc b/payload_consumer/partition_update_generator_android.cc
--- a/payload_consumer/partition_update_generator_android.cc
+++ b/payload_consumer/partition_update_generator_android.cc
@@ -62,16 +62,34 @@ bool PartitionUpdateGeneratorAndroid::
     bool is_source_dynamic = false;
     std::string source_device;
 
-    TEST_AND_RETURN_FALSE(
-        boot_control_->GetPartitionDevice(partition_name,
-                                          source_slot,
-                                          true, /* not_in_payload */
-                                          &source_device,
-                                          &is_source_dynamic));
+    const bool source_found = boot_control_->GetPartitionDevice(
+        partition_name,
+        source_slot,
+        true, /* not_in_payload */
+        &source_device,
+        &is_source_dynamic);
     bool is_target_dynamic = false;
     std::string target_device;
-    TEST_AND_RETURN_FALSE(boot_control_->GetPartitionDevice(
-        partition_name, target_slot, true, &target_device, &is_target_dynamic));
+    const bool target_found = boot_control_->GetPartitionDevice(
+        partition_name, target_slot, true, &target_device, &is_target_dynamic);
+
+    if (!source_found || !target_found) {
+      // Skip stale A/B declarations only when both slots lack the partition.
+      // Firmware layout migrations can leave an old logical-partition name in
+      // ro.vendor.build.ab_ota_partitions. A partial payload has no data to
+      // preserve for a partition absent from both source and target metadata.
+      // A one-sided absence remains an integrity failure.
+      if (!source_found && !target_found) {
+        LOG(WARNING) << "Skipping absent stale A/B partition "
+                     << partition_name;
+        continue;
+      }
+      LOG(ERROR) << "A/B partition " << partition_name
+                 << " is missing from "
+                 << (source_found ? "the target" : "the source")
+                 << " slot";
+      return false;
+    }
 
     if (is_source_dynamic || is_target_dynamic) {
       if (is_source_dynamic != is_target_dynamic) {
diff --git a/payload_consumer/partition_update_generator_android_unittest.cc b/payload_consumer/partition_update_generator_android_unittest.cc
--- a/payload_consumer/partition_update_generator_android_unittest.cc
+++ b/payload_consumer/partition_update_generator_android_unittest.cc
@@ -156,4 +156,43 @@ TEST_F(PartitionUpdateGeneratorAndroidTest, GenerateOperations) {
   CheckPartitionUpdate("system", system_contents, update_list[1]);
 }
 
+TEST_F(PartitionUpdateGeneratorAndroidTest,
+       GenerateOperationsSkipsFullyAbsentStalePartition) {
+  auto boot_contents = std::string(4096 * 5, 'b');
+  std::map<std::string, std::string> contents = {
+      {"boot_a", boot_contents},
+      {"boot_b", std::string(4096 * 5, 0)},
+  };
+  SetUpBlockDevice(contents);
+  generator_->ab_partitions_.push_back("my_company");
+
+  std::vector<PartitionUpdate> update_list;
+  ASSERT_TRUE(generator_->GenerateOperationsForPartitionsNotInPayload(
+      0, 1, std::set<std::string>{}, &update_list));
+
+  ASSERT_EQ(1u, update_list.size());
+  CheckPartitionUpdate("boot", boot_contents, update_list[0]);
+}
+
+TEST_F(PartitionUpdateGeneratorAndroidTest,
+       GenerateOperationsRejectsOneSidedAbsentPartition) {
+  auto boot_contents = std::string(4096 * 5, 'b');
+  std::map<std::string, std::string> contents = {
+      {"boot_a", boot_contents},
+      {"boot_b", std::string(4096 * 5, 0)},
+  };
+  SetUpBlockDevice(contents);
+  auto stale_source = device_dir_.GetPath().Append("my_company_a");
+  auto stale_contents = std::string(4096, 's');
+  ASSERT_TRUE(utils::WriteFile(stale_source.value().c_str(),
+                               stale_contents.data(),
+                               stale_contents.size()));
+  boot_control_->SetPartitionDevice("my_company", 0, stale_source.value());
+  generator_->ab_partitions_.push_back("my_company");
+
+  std::vector<PartitionUpdate> update_list;
+  ASSERT_FALSE(generator_->GenerateOperationsForPartitionsNotInPayload(
+      0, 1, std::set<std::string>{}, &update_list));
+}
+
 }  // namespace chromeos_update_engine
