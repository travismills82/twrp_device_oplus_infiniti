From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Travis Mills <travismills82@gmail.com>
Date: Thu, 30 Jul 2026 18:45:00 -0500
Subject: [PATCH] recovery: refresh lpdump binaries in incremental images

The recovery relink package lists lpdump and lpdumpd only as order-only
module requirements. When either binary changes, an already staged recovery
ramdisk can therefore retain the previous executable even though the system
output was rebuilt.

Make the relink package depend directly on both binaries when lpdump is
enabled. This makes the recovery staging copy refresh before ramdisk packing.
---
 prebuilt/Android.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/prebuilt/Android.mk b/prebuilt/Android.mk
--- a/prebuilt/Android.mk
+++ b/prebuilt/Android.mk
@@ -477,4 +477,8 @@ include $(CLEAR_VARS)
 LOCAL_POST_INSTALL_CMD += $(RELINK) $(TARGET_RECOVERY_ROOT_OUT)/system/bin $(RECOVERY_BINARY_SOURCE_FILES)
 TARGET_BINARY_RELINK_FILES := $(filter-out bu, $(notdir $(RECOVERY_BINARY_SOURCE_FILES)))
 LOCAL_REQUIRED_MODULES += $(TARGET_BINARY_RELINK_FILES)
+ifneq ($(TW_INCLUDE_LPDUMP),)
+# Keep incremental recovery images from retaining an older lpdump client.
+LOCAL_ADDITIONAL_DEPENDENCIES += $(TARGET_OUT_EXECUTABLES)/lpdump $(TARGET_OUT_EXECUTABLES)/lpdumpd
+endif
 include $(BUILD_PHONY_PACKAGE)
