+#ifndef TW_NO_NETWORK
+enum NetworkTileBits : unsigned { SmbTileConnected = 1, FtpTileConnected = 2 };
+static std::atomic<unsigned> network_tile_bits{0};
+
+static void* SampleNetworkTileConnections(void*)
+{
+	for (;;) {
+		// The tile sampler runs off the UI thread. Check local kernel
+		// metadata only, never make an SMB request while updating an icon.
+		unsigned bits = 0;
+		if (op15_network_sessions::Connected("smb") && !op15_smb::MountId().empty())
+			bits |= SmbTileConnected;
+		if (op15_network_sessions::Connected("ftp"))
+			bits |= FtpTileConnected;
+		network_tile_bits.store(bits, std::memory_order_relaxed);
+		sleep(1);
+	}
+}
+
+static void UpdateNetworkTileConnections()
+{
+	const auto bits = network_tile_bits.load(std::memory_order_relaxed);
+	const bool smb = (bits & SmbTileConnected) && DataManager::GetIntValue("tw_wifi_connected");
+	const bool ftp = (bits & FtpTileConnected) != 0;
+	const auto publish_connection = [](const char* name, int active) {
+		if (DataManager::GetIntValue(name) != active) {
+			DataManager::SetValue(name, active);
+			gForceRender.set_value(1);
+		}
+	};
+	publish_connection("tw_op15_dashboard_smb_connected", smb);
+	publish_connection("tw_op15_dashboard_ftp_connected", ftp);
+}
+#endif
