diff --git a/backup_safety.hpp b/backup_safety.hpp
new file mode 100644
index 0000000..3c51f0b
--- /dev/null
+++ b/backup_safety.hpp
@@ -0,0 +1,192 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef TWRP_BACKUP_SAFETY_HPP
+#define TWRP_BACKUP_SAFETY_HPP
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <dirent.h>
+#include <fstream>
+#include <set>
+#include <sstream>
+#include <string>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+#include <limits.h>
+
+// Shared by the native Nandroid path and disposable host fixtures. No code in
+// this header opens a block device for writing or changes a mount/mapping.
+namespace twrp_backup_safety {
+constexpr const char* kIncomplete = "/.twrp-incomplete";
+
+inline bool HasCapacity(uint64_t free, uint64_t wanted) {
+    constexpr uint64_t reserve = 32ULL * 1024 * 1024;
+    return free >= reserve && wanted <= free - reserve;
+}
+
+inline bool ImageLengthValid(uint64_t image, uint64_t device) {
+    // A native emmc .win is a complete partition, not a sparse/flashable image.
+    return image != 0 && device != 0 && image == device;
+}
+
+template <typename Operation>
+bool ExactIo(void* data, size_t bytes, Operation operation) {
+    auto* cursor = static_cast<uint8_t*>(data);
+    while (bytes) {
+        const ssize_t done = operation(cursor, bytes);
+        if (done < 0 && errno == EINTR) continue;
+        if (done <= 0 || static_cast<size_t>(done) > bytes) {
+            if (done == 0) errno = EIO;
+            return false;
+        }
+        cursor += done;
+        bytes -= static_cast<size_t>(done);
+    }
+    return true;
+}
+
+inline std::string DeviceId(dev_t device) {
+    return std::to_string(major(device)) + ":" + std::to_string(minor(device));
+}
+
+inline bool ContainsPath(const std::string& directory, const std::string& path) {
+    return directory == "/" || path == directory ||
+        (path.size() > directory.size() && path.compare(0, directory.size(), directory) == 0 &&
+         path[directory.size()] == '/');
+}
+
+inline std::string MountUnescape(const std::string& value) {
+    std::string result;
+    for (size_t pos = 0; pos < value.size(); ++pos) {
+        if (value[pos] == '\\' && pos + 3 < value.size() &&
+            value[pos+1] >= '0' && value[pos+1] <= '7' && value[pos+2] >= '0' && value[pos+2] <= '7' &&
+            value[pos+3] >= '0' && value[pos+3] <= '7') {
+            result += static_cast<char>((value[pos+1]-'0')*64 + (value[pos+2]-'0')*8 + value[pos+3]-'0');
+            pos += 3;
+        } else result += value[pos];
+    }
+    return result;
+}
+
+inline bool FilesystemPath(const std::string& path, const std::string& device, std::string* result,
+                           const std::string& mountinfo) {
+    char resolved[PATH_MAX];
+    if (!realpath(path.c_str(), resolved)) return false;
+    const std::string canonical(resolved);
+    std::ifstream mounts(mountinfo);
+    if (!mounts) return false;
+    std::string line;
+    size_t best = 0;
+    while (std::getline(mounts, line)) {
+        std::istringstream fields(line);
+        std::string id, parent, source, root, target, options;
+        if (!(fields >> id >> parent >> source >> root >> target >> options)) return false;
+        target = MountUnescape(target);
+        root = MountUnescape(root);
+        if (source != device || target.size() < best || !ContainsPath(target, canonical)) continue;
+        best = target.size();
+        const std::string relative = canonical.substr(target == "/" ? 0 : target.size());
+        *result = root == "/" ? (relative.empty() ? "/" : relative) : root + relative;
+    }
+    return best != 0 && !mounts.bad();
+}
+
+inline bool SafeFileBackup(const std::string& source, const std::string& destination,
+                           std::string* error, const std::string& mountinfo = "/proc/self/mountinfo") {
+    struct stat input {}, output {};
+    if (stat(source.c_str(), &input) != 0 || stat(destination.c_str(), &output) != 0) {
+        *error = "Cannot identify file backup storage"; return false;
+    }
+    if (input.st_dev != output.st_dev) return true;
+    // stat alone cannot distinguish a safe sibling directory from recursion,
+    // and realpath alone cannot resolve bind-mount aliases such as /storage.
+    std::string input_path, output_path;
+    const auto device = DeviceId(input.st_dev);
+    if (!FilesystemPath(source, device, &input_path, mountinfo) ||
+        !FilesystemPath(destination, device, &output_path, mountinfo)) {
+        *error = "Cannot resolve file backup mount roots"; return false;
+    }
+    if (ContainsPath(input_path, output_path)) {
+        *error = "Backup/restore archive is inside its own source/target tree"; return false;
+    }
+    return true;
+}
+
+inline bool CollectUsers(const std::string& device, std::set<std::string>* users,
+                         std::string* error, const std::string& sys = "/sys") {
+    if (users->count(device)) return true;
+    if (users->size() >= 128) { *error = "Block-device dependency graph is too large"; return false; }
+    users->insert(device);
+    const std::string path = sys + "/dev/block/" + device + "/holders";
+    DIR* directory = opendir(path.c_str());
+    if (!directory) { *error = "Cannot inspect block users for " + device; return false; }
+    std::set<std::string> children;
+    errno = 0;
+    while (auto* entry = readdir(directory)) {
+        if (entry->d_name[0] == '.') continue;
+        std::ifstream value(path + "/" + entry->d_name + "/dev");
+        std::string child;
+        if (!(value >> child) || child.find_first_not_of("0123456789:") != std::string::npos) {
+            closedir(directory); *error = "Cannot identify a block-device holder"; return false;
+        }
+        children.insert(child);
+        errno = 0;
+    }
+    const int saved = errno;
+    closedir(directory);
+    if (saved) { *error = "Cannot enumerate block-device holders"; return false; }
+    for (const auto& child : children)
+        if (!CollectUsers(child, users, error, sys)) return false;
+    return true;
+}
+
+inline bool BlockIsSafe(const std::string& device, bool restore, std::string* error,
+                        const std::string& sys = "/sys",
+                        const std::string& mountinfo = "/proc/self/mountinfo") {
+    std::set<std::string> users;
+    if (!CollectUsers(device, &users, error, sys)) return false;
+    if (restore && users.size() != 1) {
+        *error = "Restore target has active device-mapper/block holders"; return false;
+    }
+    std::ifstream mounts(mountinfo);
+    if (!mounts) { *error = "Cannot inspect mounted block devices"; return false; }
+    std::string line;
+    bool saw_mount = false;
+    while (std::getline(mounts, line)) {
+        std::istringstream fields(line);
+        std::string id, parent, source, root, target, options;
+        if (!(fields >> id >> parent >> source >> root >> target >> options)) {
+            *error = "Malformed mount information"; return false;
+        }
+        saw_mount = true;
+        if (users.count(source) && (restore || ("," + options + ",").find(",rw,") != std::string::npos)) {
+            *error = (restore ? "Restore target is mounted: " : "Raw backup source is writable/mounted: ") + target;
+            return false;
+        }
+    }
+    if (mounts.bad()) { *error = "Cannot finish reading mount information"; return false; }
+    if (!saw_mount) { *error = "Mount information is empty"; return false; }
+    return true;
+}
+
+inline bool SeparateStorage(const std::string& source, const std::string& destination,
+                            std::string* error) {
+    struct stat location {};
+    std::string parent = destination;
+    while (stat(parent.c_str(), &location) != 0) {
+        const auto slash = parent.find_last_of('/');
+        if (slash == std::string::npos || parent == "/") {
+            *error = "Cannot identify backup/restore image storage"; return false;
+        }
+        parent = slash == 0 ? "/" : parent.substr(0, slash);
+    }
+    std::set<std::string> users;
+    if (!CollectUsers(source, &users, error)) return false;
+    if (users.count(DeviceId(location.st_dev))) {
+        *error = "Image storage is backed by the source/target partition"; return false;
+    }
+    return true;
+}
+}  // namespace twrp_backup_safety
+#endif
