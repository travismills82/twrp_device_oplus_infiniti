+bool twrpDigestDriver::Verify_Streamed_SMB_Digest(const string& Full_Filename) {
+	if (!op15_smb::NetworkPath(Full_Filename)) return false;
+	TWFunc::GUI_Operation_Text(TW_GENERATE_DIGEST_TEXT, "Verifying SMB backup");
+	gui_print(" * Verifying SMB archive with one readback pass...\n");
+	std::vector<string> files;
+	if (!op15_smb::BackupDigestFiles(Full_Filename, &files)) return false;
+	for (const auto& file : files) {
+		if (!op15_smb::ReadbackAndSaveDigest(file)) {
+			gui_print(" * SMB verification failed: missing write digest, unreadable archive, mismatch, or checksum write error.\n");
+			return false;
+		}
+		gui_print(" * SMB archive verified; SHA-256 digest saved.\n");
+	}
+	return true;
+}
