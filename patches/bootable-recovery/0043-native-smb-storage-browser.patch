+bool TWPartitionManager::Set_Op15_Smb_Storage(const string& folder, const string& label) {
+	std::unique_lock guard(op15_smb::Session, std::try_to_lock);
+	if (!guard) return false;
+	auto id = op15_smb::MountId();
+	uint64_t free = 0;
+	if (!op15_smb::Directory(folder, id) || !op15_smb::Capacity(folder, &free)) return false;
+	Op15SmbStorage.Op15SmbMount = id;
+	Op15SmbStorage.Storage_Path = folder;
+	Op15SmbStorage.Storage_Name = "SMB: " + label;
+	Op15SmbStorage.Free = free;
+	op15_smb::Queue("tw_storage_path", folder);
+	return true;
+}
+
+bool TWPartitionManager::Disconnect_Op15_Smb() {
+	std::unique_lock guard(op15_smb::Session, std::try_to_lock);
+	if (!guard) return false;
+	if (!op15_smb::MountId().empty() && umount2(op15_smb::Root, 0) != 0) return false;
+	if (op15_smb::NetworkPath(DataManager::GetCurrentStoragePath())) {
+		auto* local = Get_Default_Storage_Partition();
+		if (!local) return false;
+		op15_smb::Queue("tw_storage_path", local->Storage_Path);
+	}
+	Op15SmbStorage.Op15SmbMount.clear();
+	Op15SmbStorage.Storage_Path.clear();
+	return true;
+}
+
 bool TWPartitionManager::Check_Directory_Backup_Destination(const TWPartition* part,
 		const string& destination, string* error) const {
 	// /storage is a bind of /data/media/0, not the standard Data backup.
 	// Data excludes media from its archive and may still use it as a destination.
 	if (part->Backup_Method != BM_FILES || part->Has_Data_Media || !(part->Mount_Flags & MS_BIND))
 		return true;
+	if (op15_smb::NetworkPath(destination)) {
+		// The verified FUSE filesystem is separate from the bind source.
+		std::unique_lock guard(op15_smb::Session, std::try_to_lock);
+		if (guard && !Op15SmbStorage.Op15SmbMount.empty() &&
+			op15_smb::MountId() == Op15SmbStorage.Op15SmbMount &&
+			op15_smb::Below(Op15SmbStorage.Storage_Path, destination)) return true;
+		*error = "SMB storage is disconnected";
+		return false;
+	}
 	return twrp_backup_safety::SafeNewBackupDirectory(part->Primary_Block_Device, destination, error);
 }

