diff --git a/oxygenos_dashboard.hpp b/oxygenos_dashboard.hpp
new file mode 100644
--- /dev/null
+++ b/oxygenos_dashboard.hpp
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Read-only dashboard policy. No mount, shell, credential or block-device I/O.
+#pragma once
+#include <chrono>
+#include <cstdlib>
+#include <fcntl.h>
+#include <sstream>
+#include <string>
+#include <unistd.h>
+
+namespace op15_dashboard {
+struct Inputs {
+    bool ready = false;
+    bool mounted = false;
+    int encrypted = -1;
+    int decrypted = -1;
+    int fbe = -1;
+    bool user0 = false;
+};
+
+inline bool Unlocked(const Inputs& s) {
+    if (!s.ready || !s.mounted || s.encrypted < 0 || s.fbe < 0) return false;
+    if (s.fbe == 1) return s.user0 && s.decrypted == 1;
+    return s.encrypted == 0 || s.decrypted == 1;
+}
+
+inline std::string Crypto(const Inputs& s) {
+    if (!s.ready) return "Unknown";
+    if (!s.mounted) return "Unavailable";
+    if (s.encrypted < 0 || s.fbe < 0) return "Unknown";
+    if (s.fbe == 1 || s.encrypted == 1) return Unlocked(s) ? "Decrypted" : "Encrypted";
+    return "Unencrypted";
+}
+
+inline std::string Storage(const Inputs& s) {
+    if (!s.ready || !s.mounted) return "Storage unavailable";
+    if (Unlocked(s)) return "Internal storage mounted";
+    if (s.encrypted == 1 || s.fbe == 1) return "Internal storage locked";
+    return "Storage unavailable";
+}
+
+inline std::string Slot(const std::string& s) {
+    if (s == "A" || s == "_a") return "Slot A";
+    if (s == "B" || s == "_b") return "Slot B";
+    return "Unknown";
+}
+
+inline int BatteryPercent(const std::string& s) {
+    if (s.empty() || s[0] < '0' || s[0] > '9') return -1;
+    char* end = nullptr;
+    long n = std::strtol(s.c_str(), &end, 10);
+    if (*end != '%' || n < 0 || n > 100) return -1;
+    ++end;
+    if (*end == '+' || *end == ' ') ++end;
+    if (*end != '\0') return -1;
+    return static_cast<int>(n);
+}
+
+inline std::string Battery(const std::string& s) {
+    int n = BatteryPercent(s);
+    return n < 0 ? "Unavailable" : std::to_string(n) + "%";
+}
+
+inline std::string Cpu(const std::string& s) {
+    if (s.empty()) return "Unavailable";
+    char* end = nullptr;
+    long n = std::strtol(s.c_str(), &end, 10);
+    if (end == s.c_str() || *end != '\0' || n <= 0 || n >= 150) return "Unavailable";
+    return std::to_string(n) + " °C";
+}
+
+inline std::string Progress(const std::string& s) {
+    if (s.empty()) return "";
+    char* end = nullptr;
+    const double n = std::strtod(s.c_str(), &end);
+    if (end == s.c_str() || *end != '\0' || !(n >= 0 && n <= 100)) return "";
+    return std::to_string(static_cast<int>(n)) + "%";
+}
+
+inline bool Charging(const std::string& text) {
+    return text == "Charging" || text == "Charging\n" || text == "Charging\r\n";
+}
+
+inline bool ReadCharging(const char* path = "/sys/class/power_supply/battery/status") {
+    int fd = open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK);
+    if (fd < 0) return false;
+    char buffer[32];
+    const ssize_t n = read(fd, buffer, sizeof(buffer));
+    close(fd);
+    return n > 0 && n < static_cast<ssize_t>(sizeof(buffer)) &&
+        Charging(std::string(buffer, static_cast<size_t>(n)));
+}
+
+inline bool CachedCharging() {
+    using Clock = std::chrono::steady_clock;
+    struct Snapshot { bool value = false; Clock::time_point next{}; };
+    static thread_local Snapshot snapshot;
+    const auto now = Clock::now();
+    if (now >= snapshot.next) {
+        snapshot.value = ReadCharging();
+        snapshot.next = std::chrono::time_point_cast<std::chrono::seconds>(now) + std::chrono::seconds(1);
+    }
+    return snapshot.value;
+}
+
+inline bool HasDataMount(const std::string& text) {
+    // mountinfo is kernel metadata. Do not stat/open encrypted /data or scan
+    // media in the GUI, and do not treat a tmpfs placeholder as mounted data.
+    std::istringstream lines(text);
+    std::string line;
+    while (std::getline(lines, line)) {
+        std::istringstream row(line);
+        std::string id, parent, device, root, target, options, token, fs, source;
+        if (!(row >> id >> parent >> device >> root >> target >> options)) continue;
+        if (target != "/data") continue;
+        bool separator = false;
+        while (row >> token) if (token == "-") { separator = true; break; }
+        if (!separator || !(row >> fs >> source)) continue;
+        if ((fs == "f2fs" || fs == "ext4") && source.compare(0, 11, "/dev/block/") == 0) return true;
+    }
+    return false;
+}
+
+inline bool ReadDataMount(const char* path = "/proc/self/mountinfo") {
+    int fd = open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK);
+    if (fd < 0) return false;
+    std::string data;
+    char buffer[4096];
+    bool complete = false;
+    while (data.size() < 262144) {
+        ssize_t n = read(fd, buffer, sizeof(buffer));
+        if (n == 0) { complete = true; break; }
+        if (n < 0) break;
+        data.append(buffer, static_cast<size_t>(n));
+    }
+    close(fd);
+    return complete && HasDataMount(data);
+}
+
+inline bool CachedDataMount() {
+    using Clock = std::chrono::steady_clock;
+    struct Snapshot { bool value = false; Clock::time_point next{}; };
+    static thread_local Snapshot snapshot;
+    const auto now = Clock::now();
+    if (now >= snapshot.next) {
+        snapshot.value = ReadDataMount();
+        snapshot.next = std::chrono::time_point_cast<std::chrono::seconds>(now) + std::chrono::seconds(1);
+    }
+    return snapshot.value;
+}
+}  // namespace op15_dashboard
