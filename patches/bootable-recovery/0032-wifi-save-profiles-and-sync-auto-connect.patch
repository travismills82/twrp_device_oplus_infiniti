+        std::istringstream state(status);
+        std::string line;
+        bool authenticated = false, selected = false;
+        while (std::getline(state, line)) {
+            if (line == "wpa_state=COMPLETED") authenticated = true;
+            if (line == "id=" + network_id) selected = true;
+        }
+        if (authenticated && selected) {
