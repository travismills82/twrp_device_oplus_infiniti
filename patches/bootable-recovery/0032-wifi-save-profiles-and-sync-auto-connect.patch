+    // OP15 saved Wi-Fi profiles START
+    struct ManualConnection {
+        std::string network;
+        bool keep = false;
+        ManualConnection() { android::base::SetProperty("twrp.wifi.manual", "1"); }
+        ~ManualConnection() {
+            if (!keep && !network.empty())
+                TWFunc::Exec_Cmd("wpa_cli -iwlan0 -p/tmp/recovery/sockets remove_network " + network + " >/dev/null 2>&1");
+            android::base::SetProperty("twrp.wifi.manual", "0");
