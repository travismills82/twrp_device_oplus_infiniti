+
     // 请求 IP
     logBox->AddLogLine("[INFO] Wi-Fi link established, requesting IP with dhcpcd...", "normal");
     gui_forceRender();
diff --git a/gui/gui.cpp b/gui/gui.cpp
index 6bb9829..0cfe98a 100755
--- a/gui/gui.cpp
+++ b/gui/gui.cpp
@@ -35,0 +36 @@
+#include <cutils/properties.h>
@@ -583,0 +585,3 @@ static int runPages(const char *page_name, const int stop_on_page_done)
+#ifndef TW_NO_NETWORK
+	time_t wifi_status_second = -1;
+#endif
@@ -587,0 +592,15 @@ static int runPages(const char *page_name, const int stop_on_page_done)
+#ifndef TW_NO_NETWORK
+		// Network I/O stays in the controller; only mirror verified status here.
+		timespec wifi_now{};
+		clock_gettime(CLOCK_MONOTONIC, &wifi_now);
+		if (wifi_now.tv_sec != wifi_status_second) {
+			wifi_status_second = wifi_now.tv_sec;
+			char wifi_state[PROP_VALUE_MAX];
+			property_get("twrp.wifi.connected", wifi_state, "0");
+			const int connected = strcmp(wifi_state, "1") == 0 ? 1 : 0;
+			if (DataManager::GetIntValue("tw_wifi_connected") != connected) {
+				DataManager::SetValue("tw_wifi_connected", connected);
+				gForceRender.set_value(1);
+			}
+		}
+#endif
