diff --git a/gui/op15_progress_style.hpp b/gui/op15_progress_style.hpp
new file mode 100644
--- /dev/null
+++ b/gui/op15_progress_style.hpp
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Paint geometry only; never changes operation progress or swipe activation.
+#pragma once
+#include <algorithm>
+
+namespace op15_theme {
+struct ProgressPieces { int body = 0, cap_source = 0, cap_dest = 0, cap_width = 0; };
+inline ProgressPieces RoundedProgress(int width, int height, int position) {
+    if (width <= 0 || height <= 0 || height > width || position <= 0) return {};
+    const int visible = std::min(width, std::max(height, std::min(position, width)));
+    const int cap = std::max(1, height / 2);
+    return {visible - cap, width - cap, visible - cap, cap};
+}
+inline int SliderFillWidth(int width, int offset, int thumb_width, int thumb_height) {
+    if (width <= 0 || offset <= 0) return 0;
+    offset = std::min(offset, width);
+    const int overlap = std::max(0, std::min(thumb_width, thumb_height) / 2);
+    return offset + std::min(overlap, width - offset);
+}
+}

