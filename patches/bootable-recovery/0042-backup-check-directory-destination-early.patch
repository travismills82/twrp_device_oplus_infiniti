+bool TWPartitionManager::Check_Directory_Backup_Destination(const TWPartition* part,
+		const string& destination, string* error) const {
+	// /storage is a bind of /data/media/0, not the standard Data backup.
+	// Data excludes media from its archive and may still use it as a destination.
+	if (part->Backup_Method != BM_FILES || part->Has_Data_Media || !(part->Mount_Flags & MS_BIND))
+		return true;
+	return twrp_backup_safety::SafeNewBackupDirectory(part->Primary_Block_Device, destination, error);
+}
