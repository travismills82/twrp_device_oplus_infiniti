+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef TWRP_BACKUP_DESTINATION_HPP
+#define TWRP_BACKUP_DESTINATION_HPP
+
+#include "backup_safety.hpp"
+
+namespace twrp_backup_safety {
+// Before creating a backup folder, identify the filesystem of its closest
+// existing directory. Do not walk past an inaccessible or dangling symlink.
+inline bool SafeNewBackupDirectory(const std::string& source, std::string destination,
+                                   std::string* error, const std::string& mountinfo = "/proc/self/mountinfo") {
+    if (!destination.empty() && destination.front() == '/') {
+        struct stat entry {};
+        while (lstat(destination.c_str(), &entry) != 0) {
+            if (errno != ENOENT || destination == "/") break;
+            auto slash = destination.rfind('/');
+            destination.resize(slash == 0 ? 1 : slash);
+        }
+        if (stat(destination.c_str(), &entry) == 0 && S_ISDIR(entry.st_mode))
+            return SafeFileBackup(source, destination, error, mountinfo);
+    }
+    *error = "Cannot identify the backup directory";
+    return false;
+}
+
+inline void RemoveBackupSelection(std::string* list, const std::string& path) {
+    for (size_t start = 0; start < list->size();) {
+        const size_t end = list->find(';', start);
+        const size_t length = (end == std::string::npos ? list->size() : end) - start;
+        if (list->compare(start, length, path) == 0)
+            list->erase(start, length + (end != std::string::npos));
+        else if (end == std::string::npos)
+            break;
+        else
+            start = end + 1;
+    }
+}
+}
+#endif
