From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Travis Mills <travismills82@gmail.com>
Date: Mon, 31 Aug 2026 19:30:00 -0500
Subject: [PATCH] theme: use OLED black with OP15 blue accents

Keep the built-in portrait HDPI theme and its existing image resources, but
replace its gray page, header, status, navigation, dialog, list, console,
terminal, and keyboard backgrounds with true #000000 via the shared background
palette.
Use the existing #0090CA direction for the thin header accent, pressed
highlights, and list separators so the UI remains legible alongside the OP15
Wi-Fi status icon.

This intentionally changes XML only. It does not import an external theme,
add image assets, alter the WLAN pages, or change the Wi-Fi status icon,
tw_wifi_connected variable, or icon placement.
---
 gui/theme/portrait_hdpi/splash.xml | 14 ++++++++++----
 gui/theme/portrait_hdpi/ui.xml     | 52 +++++++++++++++++++-----------------
 2 files changed, 41 insertions(+), 25 deletions(-)

diff --git a/gui/theme/portrait_hdpi/splash.xml b/gui/theme/portrait_hdpi/splash.xml
--- a/gui/theme/portrait_hdpi/splash.xml
+++ b/gui/theme/portrait_hdpi/splash.xml
@@ -17,9 +17,12 @@
 	<variables>
 		<variable name="screen_width" value="1080"/>
 		<variable name="screen_height" value="1920"/>
-		<variable name="background_color" value="#222222"/>
-		<variable name="header_color" value="#555555"/>
+		<!-- OP15 OLED black theme START -->
+		<variable name="background_color" value="#000000"/>
+		<variable name="header_color" value="#000000"/>
+		<variable name="text_color" value="#EEEEEE"/>
 		<variable name="accent_color" value="#0090CA"/>
+		<!-- OP15 OLED black theme END -->
 	</variables>
 
 	<pages>
@@ -30,6 +33,10 @@
 				<placement x="0" y="0" w="%screen_width%" h="456"/>
 			</fill>
 
+			<fill color="%accent_color%">
+				<placement x="0" y="450" w="%screen_width%" h="6"/>
+			</fill>
+
 			<image>
 				<image resource="splashlogo"/>
 				<placement x="540" y="456" placement="4"/>
@@ -40,7 +47,7 @@
 				<placement x="540" y="1540" placement="4"/>
 			</image>
 
-			<text color="%header_color%">
+			<text color="%text_color%">
 				<font resource="font_l"/>
 				<placement x="540" y="1590" placement="5"/>
 				<text>Recovery Project %tw_version%</text>
@@ -48,4 +55,3 @@
 		</page>
 	</pages>
 </recovery>
-
