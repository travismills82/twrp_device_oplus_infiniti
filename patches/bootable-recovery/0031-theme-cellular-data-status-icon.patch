diff --git a/gui/fill.cpp b/gui/fill.cpp
index f813bf3..64a5e42 100644
--- a/gui/fill.cpp
+++ b/gui/fill.cpp
@@ -46 +46 @@
-GUIFill::GUIFill(xml_node<>* node) : GUIObject(node)
+GUIFill::GUIFill(xml_node<>* node) : GUIObject(node), mLastVisible(false)
@@ -63 +63,2 @@
-	if (!isConditionTrue())
+	mLastVisible = isConditionTrue();
+	if (!mLastVisible)
@@ -70,0 +72,9 @@
+int GUIFill::Update(void)
+{
+	const bool visible = isConditionTrue();
+	if (visible == mLastVisible)
+		return 0;
+	mLastVisible = visible;
+	return 2; // Repaint on both show and hide, clearing stale pixels.
+}
