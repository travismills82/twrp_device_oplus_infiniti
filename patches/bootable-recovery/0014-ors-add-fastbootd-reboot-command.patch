From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Travis Mills <travismills82@gmail.com>
Date: Sat, 25 Jul 2026 11:00:00 -0500
Subject: [PATCH] ors: expose fastbootd reboot from the TWRP CLI

TWRP already provides rb_fastboot for entering userspace fastboot, but the
OpenRecoveryScript reboot parser does not expose it. As a result, commands
such as `twrp reboot fastboot` fall through to a normal system reboot.

Accept both `fastboot` and `fastbootd` as CLI aliases for rb_fastboot and
advertise both targets in the command-line help. Bootloader fastboot remains
available separately through `twrp reboot bootloader`.
---
 openrecoveryscript.cpp | 3 +++
 orscmd/orscmd.cpp      | 2 +-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/openrecoveryscript.cpp b/openrecoveryscript.cpp
--- a/openrecoveryscript.cpp
+++ b/openrecoveryscript.cpp
@@ -356,6 +356,9 @@ int OpenRecoveryScript::run_script_file(void) {
 					TWFunc::tw_reboot(rb_download);
 				else if (strlen(value) && strcmp(value, "edl") == 0)
 					TWFunc::tw_reboot(rb_edl);
+				else if (strlen(value) &&
+						 (strcmp(value, "fastboot") == 0 || strcmp(value, "fastbootd") == 0))
+					TWFunc::tw_reboot(rb_fastboot);
 				else
 					TWFunc::tw_reboot(rb_system);
 			} else if (strcmp(command, "cmd") == 0) {
diff --git a/orscmd/orscmd.cpp b/orscmd/orscmd.cpp
--- a/orscmd/orscmd.cpp
+++ b/orscmd/orscmd.cpp
@@ -56,6 +56,6 @@ void print_usage(void) {
 	printf("  listmounts\n");
 	printf("  print <value>\n");
 	printf("  mkdir <directory>\n");
-	printf("  reboot [recovery|poweroff|bootloader|download|edl]\n");
+	printf("  reboot [recovery|poweroff|bootloader|download|edl|fastboot|fastbootd]\n");
 	printf("\nSee more documentation at https://twrp.me/faq/openrecoveryscript.html\n");
 }
