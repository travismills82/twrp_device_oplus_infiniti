+int GUIAction::op15charging(std::string arg)
+{
+	operation_start("Charging");
+	if (arg != "status" && arg != "bypass-on" && arg != "bypass-off" && arg != "auto") {
+		gui_print("Unknown charging action.\n");
+		operation_end(1);
+		return 0;
+	}
+	if (simulate) {
+		simulate_progress_bar();
+		operation_end(0);
+		return 0;
+	}
+	std::string output;
+	int result = TWFunc::Exec_Cmd("/system/bin/twrp-charging " + arg, output, true);
+	gui_print("%s", output.c_str());
+	operation_end(result == 0 ? 0 : 1);
 	return 0;
 }
 
