on init
    start vendor.keymint

service vendor.keymint /vendor/bin/hw/android.hardware.security.onekeymint-service-qti
    class early_hal
    user system
    group system drmrpc
    seclabel u:r:recovery:s0

on property:vendor.car.hiber=hiberExit
    stop vendor.keymint
    start vendor.keymint
    stop keystore2
    start keystore2
