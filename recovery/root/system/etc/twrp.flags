# mount point           fstype  device                                                        device2                      flags
# TWRP flags generated to expose backup and image flashing for OnePlus 15 / Oplus Infiniti.
# Logical mounted partitions
/system                erofs   system                                                                                      flags=display="System";backup=1;logical;slotselect
/system_ext            erofs   system_ext                                                                                  flags=display="System Ext";backup=1;logical;slotselect
/product               erofs   product                                                                                     flags=display="Product";backup=1;logical;slotselect
/vendor                erofs   vendor                                                                                      flags=display="Vendor";backup=1;logical;slotselect
/vendor_dlkm           erofs   vendor_dlkm                                                                                 flags=display="Vendor DLKM";backup=1;logical;slotselect
/system_dlkm           erofs   system_dlkm                                                                                 flags=display="System DLKM";backup=1;logical;slotselect
/system_dlkm_oki       erofs   system_dlkm_oki                                                                             flags=display="System DLKM OKI";backup=1;logical;slotselect
/odm                   erofs   odm                                                                                         flags=display="ODM";backup=1;logical;slotselect
/my_product            erofs   my_product                                                                                  flags=display="My Product";backup=1;logical;slotselect
/my_engineering        erofs   my_engineering                                                                              flags=display="My Engineering";backup=1;logical;slotselect
/my_company            erofs   my_company                                                                                  flags=display="My Company";backup=1;logical;slotselect
/my_carrier            erofs   my_carrier                                                                                  flags=display="My Carrier";backup=1;logical;slotselect
/my_region             erofs   my_region                                                                                   flags=display="My Region";backup=1;logical;slotselect
/my_heytap             erofs   my_heytap                                                                                   flags=display="My Heytap";backup=1;logical;slotselect
/my_stock              erofs   my_stock                                                                                    flags=display="My Stock";backup=1;logical;slotselect
/my_preload            erofs   my_preload                                                                                  flags=display="My Preload";backup=1;logical;slotselect
/my_bigball            erofs   my_bigball                                                                                  flags=display="My Bigball";backup=1;logical;slotselect
/my_manifest           erofs   my_manifest                                                                                 flags=display="My Manifest";backup=1;logical;slotselect

# Userdata / metadata / persistent partitions
/metadata              f2fs    /dev/block/by-name/metadata                                                                 flags=display="Metadata";backup=1
/data                  f2fs    /dev/block/bootdevice/by-name/userdata                                                      flags=display="Data";backup=1;userdataencryptbackup=1;canencryptbackup=1
/mnt/vendor/persist    ext4    /dev/block/bootdevice/by-name/persist                                                       flags=display="Persist";backup=1
/mnt/vendor/oplusreserve ext4    /dev/block/by-name/oplusreserve2                                                            flags=display="Oplus Reserve2";backup=1
/mnt/vendor/vm-persist ext4    /dev/block/bootdevice/by-name/vm-persist                                                    flags=display="VM Persist";backup=1
/mnt/vendor/qmcs       vfat    /dev/block/bootdevice/by-name/qmcs                                                          flags=display="QMCS";backup=1
/mnt/vendor/spunvm     vfat    /dev/block/bootdevice/by-name/spunvm                                                        flags=display="SPUNVM";backup=1

# Boot / AVB image partitions
/boot                  emmc    /dev/block/by-name/boot                                                                     flags=slotselect;display="Boot";backup=1;flashimg=1
/init_boot             emmc    /dev/block/by-name/init_boot                                                                flags=slotselect;display="Init Boot";backup=1;flashimg=1
/vendor_boot           emmc    /dev/block/by-name/vendor_boot                                                              flags=slotselect;display="Vendor Boot";backup=1;flashimg=1
/recovery              emmc    /dev/block/by-name/recovery                                                                 flags=slotselect;display="Recovery";backup=1;flashimg=1
/dtbo                  emmc    /dev/block/by-name/dtbo                                                                     flags=slotselect;display="DTBO";backup=1;flashimg=1
/vbmeta                emmc    /dev/block/bootdevice/by-name/vbmeta                                                        flags=slotselect;display="VBMeta";backup=1;flashimg=1
/vbmeta_system         emmc    /dev/block/bootdevice/by-name/vbmeta_system                                                 flags=slotselect;display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor         emmc    /dev/block/bootdevice/by-name/vbmeta_vendor                                                 flags=slotselect;display="VBMeta Vendor";backup=1;flashimg=1
/misc                  emmc    /dev/block/by-name/misc                                                                     flags=display="Misc";backup=1;flashimg=1

# Firmware and modem-related partitions
/vendor/firmware_mnt   vfat    /dev/block/bootdevice/by-name/modem                                                         flags=slotselect;display="Modem";backup=1
/vendor/dsp            ext4    /dev/block/bootdevice/by-name/dsp                                                           flags=slotselect;display="DSP";backup=1
/vendor/vm-system      ext4    /dev/block/bootdevice/by-name/vm-bootsys                                                    flags=slotselect;display="VM Bootsys";backup=1
/vendor/bt_firmware    vfat    /dev/block/bootdevice/by-name/bluetooth                                                     flags=slotselect;display="Bluetooth";backup=1
/vendor/soccp_firmware vfat    /dev/block/bootdevice/by-name/soccp                                                         flags=slotselect;display="SOCCP";backup=1

# Raw image backup/flash targets
/oplusreserve2_image   emmc    /dev/block/by-name/oplusreserve2                                                            flags=display="Oplus Reserve2 Image";backup=1;flashimg=1
/system_image          emmc    system                                                                                      flags=slotselect;logical;display="System Image";backup=1;flashimg=1
/system_ext_image      emmc    system_ext                                                                                  flags=slotselect;logical;display="System Ext Image";backup=1;flashimg=1
/product_image         emmc    product                                                                                     flags=slotselect;logical;display="Product Image";backup=1;flashimg=1
/vendor_image          emmc    vendor                                                                                      flags=slotselect;logical;display="Vendor Image";backup=1;flashimg=1
/vendor_dlkm_image     emmc    vendor_dlkm                                                                                 flags=slotselect;logical;display="Vendor DLKM Image";backup=1;flashimg=1
/system_dlkm_image     emmc    system_dlkm                                                                                 flags=slotselect;logical;display="System DLKM Image";backup=1;flashimg=1
/odm_image             emmc    odm                                                                                         flags=slotselect;logical;display="ODM Image";backup=1;flashimg=1
/my_product_image      emmc    my_product                                                                                  flags=slotselect;logical;display="My Product Image";backup=1;flashimg=1
/my_engineering_image  emmc    my_engineering                                                                              flags=slotselect;logical;display="My Engineering Image";backup=1;flashimg=1
/my_company_image      emmc    my_company                                                                                  flags=slotselect;logical;display="My Company Image";backup=1;flashimg=1
/my_carrier_image      emmc    my_carrier                                                                                  flags=slotselect;logical;display="My Carrier Image";backup=1;flashimg=1
/my_region_image       emmc    my_region                                                                                   flags=slotselect;logical;display="My Region Image";backup=1;flashimg=1
/my_heytap_image       emmc    my_heytap                                                                                   flags=slotselect;logical;display="My Heytap Image";backup=1;flashimg=1
/my_stock_image        emmc    my_stock                                                                                    flags=slotselect;logical;display="My Stock Image";backup=1;flashimg=1
/my_preload_image      emmc    my_preload                                                                                  flags=slotselect;logical;display="My Preload Image";backup=1;flashimg=1
/my_bigball_image      emmc    my_bigball                                                                                  flags=slotselect;logical;display="My Bigball Image";backup=1;flashimg=1
/my_manifest_image     emmc    my_manifest                                                                                 flags=slotselect;logical;display="My Manifest Image";backup=1;flashimg=1
/metadata_image        emmc    /dev/block/by-name/metadata                                                                 flags=display="Metadata Image";backup=1;flashimg=1
/persist_image         emmc    /dev/block/bootdevice/by-name/persist                                                       flags=display="Persist Image";backup=1;flashimg=1
/userdata_image        emmc    /dev/block/bootdevice/by-name/userdata                                                      flags=display="Data Image";backup=1;flashimg=1
/modem_image           emmc    /dev/block/bootdevice/by-name/modem                                                         flags=slotselect;display="Modem Image";backup=1;flashimg=1
/dsp_image             emmc    /dev/block/bootdevice/by-name/dsp                                                           flags=slotselect;display="DSP Image";backup=1;flashimg=1
/vm_bootsys_image      emmc    /dev/block/bootdevice/by-name/vm-bootsys                                                    flags=slotselect;display="VM Bootsys Image";backup=1;flashimg=1
/vm_persist_image      emmc    /dev/block/bootdevice/by-name/vm-persist                                                    flags=display="VM Persist Image";backup=1;flashimg=1
/bluetooth_image       emmc    /dev/block/bootdevice/by-name/bluetooth                                                     flags=slotselect;display="Bluetooth Image";backup=1;flashimg=1
/qmcs_image            emmc    /dev/block/bootdevice/by-name/qmcs                                                          flags=display="QMCS Image";backup=1;flashimg=1
/spunvm_image          emmc    /dev/block/bootdevice/by-name/spunvm                                                        flags=display="SPUNVM Image";backup=1;flashimg=1
/soccp_image           emmc    /dev/block/bootdevice/by-name/soccp                                                         flags=slotselect;display="SOCCP Image";backup=1;flashimg=1
/system_dlkm_oki_image emmc    system_dlkm_oki                                                                             flags=slotselect;logical;display="System DLKM OKI Image";backup=1;flashimg=1
/vbmeta                emmc    /dev/block/bootdevice/by-name/vbmeta                                                        flags=slotselect;display="VBMeta";backup=1;flashimg=1
/vbmeta_system         emmc    /dev/block/bootdevice/by-name/vbmeta_system                                                 flags=slotselect;display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor         emmc    /dev/block/bootdevice/by-name/vbmeta_vendor                                                 flags=slotselect;display="VBMeta Vendor";backup=1;flashimg=1
/efs1                  emmc    /dev/block/bootdevice/by-name/modemst1                                                      flags=display="EFS";backup=1;flashimg=1
/efs2                  emmc    /dev/block/bootdevice/by-name/modemst2                                                      flags=display="EFS Backup";backup=1;flashimg=1
/efsc                  emmc    /dev/block/bootdevice/by-name/fsc                                                           flags=display="FSC";backup=1;flashimg=1
/efsg                  emmc    /dev/block/bootdevice/by-name/fsg                                                           flags=display="FSG";backup=1;flashimg=1

# Removable storage
/storage               auto    /data/media/0                                                                               flags=display="Internal Storage";backup=1;usermrf;fsflags="bind,utf8";removable
/usb_otg               vfat    /dev/block/sdg1                                                /dev/block/sdg               flags=display="USB-Storage";fsflags=utf8;storage;wipeingui;removable
