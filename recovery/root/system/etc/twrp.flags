# mount point           fstype  device                                                        device2                      flags
#
# recovery.fstab owns mounted logical volumes. This file adds backup and image
# targets without replacing their resolved block-device paths.

# Filesystem backups for partitions already defined in recovery.fstab
/metadata              f2fs    /dev/block/by-name/metadata                                                                 flags=display="Metadata";backup=1
/data                  f2fs    /dev/block/bootdevice/by-name/userdata                                                      flags=display="Data";backup=1;userdataencryptbackup=1;canencryptbackup=1
# Keep Data as a file backup only: data-media is the backup destination, so a
# raw userdata image would require more free space than that destination has.
/persist               ext4    /dev/block/bootdevice/by-name/persist                                                       flags=display="Persist";backup=1

# Required before FBE decryption; keep this separate from the raw modem image.
/firmware              vfat    /dev/block/bootdevice/by-name/modem                                                         flags=slotselect;display="Firmware";mounttodecrypt;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"

# Raw image backup and flash targets. recovery.fstab prepares logical volumes
# first and creates these active-slot by-name symlinks for them.
/boot                  emmc    /dev/block/bootdevice/by-name/boot                                                       flags=slotselect;display="Boot";backup=1;flashimg=1
/init_boot             emmc    /dev/block/bootdevice/by-name/init_boot                                                  flags=slotselect;display="Init Boot";backup=1;flashimg=1
/vendor_boot           emmc    /dev/block/bootdevice/by-name/vendor_boot                                                flags=slotselect;display="Vendor Boot";backup=1;flashimg=1
/dtbo                  emmc    /dev/block/bootdevice/by-name/dtbo                                                       flags=slotselect;display="DTBO";backup=1;flashimg=1
/recovery              emmc    /dev/block/bootdevice/by-name/recovery                                                   flags=slotselect;display="Recovery";backup=1;flashimg=1
/oplusreserve2_image   emmc    /dev/block/by-name/oplusreserve2                                                            flags=display="Oplus Reserve2 Image";backup=1;flashimg=1
/system_image          emmc    /dev/block/bootdevice/by-name/system                                                        flags=display="System Image";backup=1;flashimg=1
/system_ext_image      emmc    /dev/block/bootdevice/by-name/system_ext                                                    flags=display="System Ext Image";backup=1;flashimg=1
/product_image         emmc    /dev/block/bootdevice/by-name/product                                                       flags=display="Product Image";backup=1;flashimg=1
/vendor_image          emmc    /dev/block/bootdevice/by-name/vendor                                                        flags=display="Vendor Image";backup=1;flashimg=1
/vendor_dlkm_image     emmc    /dev/block/bootdevice/by-name/vendor_dlkm                                                   flags=display="Vendor DLKM Image";backup=1;flashimg=1
/system_dlkm_image     emmc    /dev/block/bootdevice/by-name/system_dlkm                                                   flags=display="System DLKM Image";backup=1;flashimg=1
/system_dlkm_oki_image emmc    /dev/block/bootdevice/by-name/system_dlkm_oki                                               flags=display="System DLKM OKI Image";backup=1;flashimg=1
/odm_image             emmc    /dev/block/bootdevice/by-name/odm                                                           flags=display="ODM Image";backup=1;flashimg=1
/my_product_image      emmc    /dev/block/bootdevice/by-name/my_product                                                    flags=display="My Product Image";backup=1;flashimg=1
/my_engineering_image  emmc    /dev/block/bootdevice/by-name/my_engineering                                                flags=display="My Engineering Image";backup=1;flashimg=1
/my_company_image      emmc    /dev/block/bootdevice/by-name/my_company                                                    flags=display="My Company Image";backup=1;flashimg=1
/my_carrier_image      emmc    /dev/block/bootdevice/by-name/my_carrier                                                    flags=display="My Carrier Image";backup=1;flashimg=1
/my_region_image       emmc    /dev/block/bootdevice/by-name/my_region                                                     flags=display="My Region Image";backup=1;flashimg=1
/my_heytap_image       emmc    /dev/block/bootdevice/by-name/my_heytap                                                     flags=display="My Heytap Image";backup=1;flashimg=1
/my_stock_image        emmc    /dev/block/bootdevice/by-name/my_stock                                                      flags=display="My Stock Image";backup=1;flashimg=1
/my_preload_image      emmc    /dev/block/bootdevice/by-name/my_preload                                                    flags=display="My Preload Image";backup=1;flashimg=1
/my_bigball_image      emmc    /dev/block/bootdevice/by-name/my_bigball                                                    flags=display="My Bigball Image";backup=1;flashimg=1
/my_manifest_image     emmc    /dev/block/bootdevice/by-name/my_manifest                                                   flags=display="My Manifest Image";backup=1;flashimg=1
/metadata_image        emmc    /dev/block/by-name/metadata                                                                 flags=display="Metadata Image";backup=1;flashimg=1
/persist_image         emmc    /dev/block/bootdevice/by-name/persist                                                       flags=display="Persist Image";backup=1;flashimg=1
/modem_image           emmc    /dev/block/bootdevice/by-name/modem                                                         flags=slotselect;display="Modem Image";backup=1;flashimg=1
/dsp_image             emmc    /dev/block/bootdevice/by-name/dsp                                                           flags=slotselect;display="DSP Image";backup=1;flashimg=1
/bluetooth_image       emmc    /dev/block/bootdevice/by-name/bluetooth                                                     flags=slotselect;display="Bluetooth Image";backup=1;flashimg=1
/qmcs_image            emmc    /dev/block/bootdevice/by-name/qmcs                                                          flags=display="QMCS Image";backup=1;flashimg=1
/spunvm_image          emmc    /dev/block/bootdevice/by-name/spunvm                                                        flags=display="SPUNVM Image";backup=1;flashimg=1
/soccp_image           emmc    /dev/block/bootdevice/by-name/soccp                                                         flags=slotselect;display="SOCCP Image";backup=1;flashimg=1
/vbmeta                emmc    /dev/block/bootdevice/by-name/vbmeta                                                        flags=slotselect;display="VBMeta";backup=1;flashimg=1
/vbmeta_system         emmc    /dev/block/bootdevice/by-name/vbmeta_system                                                 flags=slotselect;display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor         emmc    /dev/block/bootdevice/by-name/vbmeta_vendor                                                 flags=slotselect;display="VBMeta Vendor";backup=1;flashimg=1
/misc                  emmc    /dev/block/bootdevice/by-name/misc                                                          flags=display="Misc";backup=1;flashimg=1
/efs1                  emmc    /dev/block/bootdevice/by-name/modemst1                                                      flags=display="EFS";backup=1;flashimg=1
/efs2                  emmc    /dev/block/bootdevice/by-name/modemst2                                                      flags=display="EFS Backup";backup=1;flashimg=1
/efsc                  emmc    /dev/block/bootdevice/by-name/fsc                                                           flags=display="FSC";backup=1;flashimg=1
/efsg                  emmc    /dev/block/bootdevice/by-name/fsg                                                           flags=display="FSG";backup=1;flashimg=1

# Removable storage
/storage               auto    /data/media/0                                                                               flags=display="Internal Storage";backup=1;usermrf;fsflags="bind,utf8";removable
/usb_otg               vfat    /dev/block/sdg1                                                /dev/block/sdg               flags=display="USB-Storage";fsflags=utf8;storage;wipeingui;removable
