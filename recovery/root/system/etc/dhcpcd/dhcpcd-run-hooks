#!/system/bin/sh
#
# TWRP dhcpcd hook for wlan0.
# Publish DHCP-provided DNS servers and request a root-owned resolver publish.
#

IFACE="${interface:-wlan0}"
FALLBACK_DNS1="${TWRP_DNS1:-1.1.1.1}"
FALLBACK_DNS2="${TWRP_DNS2:-8.8.8.8}"

DNS_LIST="${new_domain_name_servers:-${domain_name_servers:-}}"

# Split the space-separated DHCP DNS list into positional parameters.
# shellcheck disable=SC2086
set -- $DNS_LIST

DNS1="${1:-$FALLBACK_DNS1}"
DNS2="${2:-$FALLBACK_DNS2}"

setprop twrp.wifi.dns.ready 0 2>/dev/null || true
setprop "dhcp.${IFACE}.dns1" "$DNS1" 2>/dev/null || true
setprop "dhcp.${IFACE}.dns2" "$DNS2" 2>/dev/null || true
setprop "net.${IFACE}.dns1" "$DNS1" 2>/dev/null || true
setprop "net.${IFACE}.dns2" "$DNS2" 2>/dev/null || true
setprop net.dns1 "$DNS1" 2>/dev/null || true
setprop net.dns2 "$DNS2" 2>/dev/null || true
setprop twrp.wifi.dns1 "$DNS1" 2>/dev/null || true
setprop twrp.wifi.dns2 "$DNS2" 2>/dev/null || true

DNSCHANGE="$(getprop net.dnschange 2>/dev/null)"
case "$DNSCHANGE" in
    ''|*[!0-9]*) DNSCHANGE=0 ;;
esac
setprop net.dnschange "$((DNSCHANGE + 1))" 2>/dev/null || true

# dhcpcd runs hooks with reduced privileges and cannot safely create or replace
# /tmp/twrp-resolv.conf. Toggle the property watched by init instead; the
# root-owned twrp-dns-publish service creates the resolver file, bind-mounts it
# onto /system/etc/resolv.conf, and verifies the resulting DNS state.
setprop twrp.wifi.dns.request 0 2>/dev/null || true
setprop twrp.wifi.dns.request 1 2>/dev/null || true

# Publishing is asynchronous. A successful hook means DNS data was collected;
# the root helper owns resolver creation, the bind mount, and ready-state checks.
exit 0
