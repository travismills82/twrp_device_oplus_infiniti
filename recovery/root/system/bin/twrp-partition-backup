#!/system/bin/sh
# Keep the historical terminal entry point, but use the normal native TWRP
# workflow and its destination, progress, digest and restore handling. Never
# create unverified flat dd files or report success after an I/O error.
if [ "$#" -ne 0 ]; then
    echo "Usage: twrp-partition-backup (opens TWRP Backup)" >&2
    exit 64
fi
echo "Opening TWRP Backup. Select partitions and storage, then swipe to begin."
exec /system/bin/twrp changepage=backup
