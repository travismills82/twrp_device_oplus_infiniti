#!/system/bin/sh

PERSIST_BLOCKS="/dev/block/bootdevice/by-name/persist /dev/block/by-name/persist"
PERSIST_VENDOR_MOUNT="/mnt/vendor/persist"
PERSIST_TWRP_MOUNT="/persist"
SECURE_ELEMENT_SERVICES="vendor.secure_element se_omapi vendor.ssgtzd"
CRYPTO_SERVICES="vendor.qseecomd vendor.gatekeeper_default vendor.keymint-qti vendor.weaver_nxp keystore2"
REQUIRED_BINDER_SERVICES="android.system.keystore2.IKeystoreService/default android.hardware.gatekeeper.IGatekeeper/default android.hardware.security.keymint.IKeyMintDevice/default android.hardware.weaver.IWeaver/default"

log_msg() {
    echo "[twrp-decrypt] $1"
    echo "[twrp-decrypt] $1" > /dev/kmsg 2>/dev/null || true
}

set_status() {
    setprop twrp.decrypt.status "$1" 2>/dev/null || true
}

service_state() {
    getprop "init.svc.$1" 2>/dev/null
}

start_service() {
    svc="$1"
    state="$(service_state "$svc")"
    case "$state" in
        running|restarting)
            log_msg "$svc already $state"
            return 0
            ;;
    esac

    log_msg "starting $svc"
    setprop ctl.start "$svc" 2>/dev/null || true
}

stop_service() {
    svc="$1"
    state="$(service_state "$svc")"
    case "$state" in
        running|restarting|starting)
            log_msg "stopping $svc"
            setprop ctl.stop "$svc" 2>/dev/null || true
            ;;
        *)
            return 0
            ;;
    esac

    count=0
    while [ "$count" -lt 10 ]; do
        state="$(service_state "$svc")"
        case "$state" in
            stopped|"") return 0 ;;
        esac
        sleep 1
        count=$((count + 1))
    done

    log_msg "$svc did not stop cleanly; continuing"
    return 1
}

restart_service() {
    svc="$1"
    stop_service "$svc" || true
    start_service "$svc"
}

wait_service_running() {
    svc="$1"
    timeout="$2"
    count=0

    while [ "$count" -lt "$timeout" ]; do
        [ "$(service_state "$svc")" = "running" ] && return 0
        sleep 1
        count=$((count + 1))
    done

    log_msg "$svc not running after ${timeout}s; continuing"
    return 1
}

wait_property() {
    name="$1"
    expected="$2"
    timeout="$3"
    count=0

    while [ "$count" -lt "$timeout" ]; do
        [ "$(getprop "$name" 2>/dev/null)" = "$expected" ] && return 0
        sleep 1
        count=$((count + 1))
    done

    return 1
}

binder_service_available() {
    name="$1"

    if command -v service >/dev/null 2>&1; then
        out="$(service check "$name" 2>/dev/null || true)"
        echo "$out" | grep -qi "found" && return 0
        echo "$out" | grep -qi "not found" && return 1
    fi

    # If the service command is not available in this recovery build, do not
    # hard fail here. init service-state checks above are still useful.
    [ ! -x /system/bin/service ] && [ ! -x /sbin/service ] && return 0

    return 1
}

wait_binder_service() {
    name="$1"
    timeout="$2"
    count=0

    while [ "$count" -lt "$timeout" ]; do
        binder_service_available "$name" && {
            log_msg "binder ready: $name"
            return 0
        }
        sleep 1
        count=$((count + 1))
    done

    log_msg "binder service not ready after ${timeout}s: $name"
    return 1
}

is_mounted() {
    target="$1"
    grep -q " $target " /proc/mounts 2>/dev/null
}

find_persist_block() {
    for block in $PERSIST_BLOCKS; do
        [ -e "$block" ] && echo "$block" && return 0
    done
    return 1
}

bind_persist_mount() {
    src="$1"
    dst="$2"

    is_mounted "$dst" && return 0
    mkdir -p "$dst" 2>/dev/null || true

    log_msg "binding $src to $dst"
    mount -o bind "$src" "$dst" 2>/tmp/twrp-persist-bind.err && return 0

    log_msg "failed binding $src to $dst: $(cat /tmp/twrp-persist-bind.err 2>/dev/null)"
    return 1
}

mount_persist() {
    mkdir -p "$PERSIST_VENDOR_MOUNT" "$PERSIST_TWRP_MOUNT" 2>/dev/null || true

    if is_mounted "$PERSIST_VENDOR_MOUNT"; then
        log_msg "$PERSIST_VENDOR_MOUNT already mounted"
        bind_persist_mount "$PERSIST_VENDOR_MOUNT" "$PERSIST_TWRP_MOUNT" || true
    elif is_mounted "$PERSIST_TWRP_MOUNT"; then
        log_msg "$PERSIST_TWRP_MOUNT already mounted"
        bind_persist_mount "$PERSIST_TWRP_MOUNT" "$PERSIST_VENDOR_MOUNT" || true
    else
        count=0
        block=""
        while [ "$count" -lt 10 ]; do
            block="$(find_persist_block)" && break
            sleep 1
            count=$((count + 1))
        done

        if [ -z "$block" ]; then
            log_msg "persist block device not found"
            return 1
        fi

        log_msg "mounting $PERSIST_VENDOR_MOUNT from $block"
        if ! mount -t ext4 -o noatime,nosuid,nodev,barrier=1 "$block" "$PERSIST_VENDOR_MOUNT" 2>/tmp/twrp-persist-mount.err; then
            mount -t ext4 "$block" "$PERSIST_VENDOR_MOUNT" 2>/tmp/twrp-persist-mount.err || {
                log_msg "failed to mount $PERSIST_VENDOR_MOUNT: $(cat /tmp/twrp-persist-mount.err 2>/dev/null)"
                return 1
            }
        fi

        bind_persist_mount "$PERSIST_VENDOR_MOUNT" "$PERSIST_TWRP_MOUNT" || {
            log_msg "bind mount failed; mounting persist directly at $PERSIST_TWRP_MOUNT"
            mount -t ext4 "$block" "$PERSIST_TWRP_MOUNT" 2>/tmp/twrp-persist-mount.err || true
        }
    fi

    if ! is_mounted "$PERSIST_VENDOR_MOUNT"; then
        log_msg "$PERSIST_VENDOR_MOUNT is not mounted after setup"
        return 1
    fi

    if ! is_mounted "$PERSIST_TWRP_MOUNT"; then
        log_msg "$PERSIST_TWRP_MOUNT is not mounted after setup"
        return 1
    fi

    log_msg "persist ready at $PERSIST_VENDOR_MOUNT and $PERSIST_TWRP_MOUNT"
    return 0
}

set_status preparing
if ! mount_persist; then
    set_status persist-mount-failed
    setprop twrp.decrypt.prereq failed 2>/dev/null || true
    log_msg "persist mount setup failed; not starting decrypt services"
    exit 1
fi

# The NXP Weaver transport refuses requests while Android reports that boot is
# incomplete. Recovery has no framework boot sequence, so mark it complete
# before bringing up the secure-element and crypto services.
setprop sys.boot_completed 1 2>/dev/null || true
wait_property sys.boot_completed 1 5 || log_msg "sys.boot_completed did not settle"

set_status starting-secure-element
for svc in $SECURE_ELEMENT_SERVICES; do
    start_service "$svc"
done
for svc in $SECURE_ELEMENT_SERVICES; do
    wait_service_running "$svc" 20 || true
done

# Give the eSE/OMAPI stack time to publish readers before Weaver initializes.
sleep 2

set_status starting-crypto-services
for svc in vendor.qseecomd vendor.gatekeeper_default vendor.keymint-qti keystore2; do
    start_service "$svc"
done

# Weaver may have been started earlier by vendor init while boot was still
# incomplete. Restart it after boot-complete, persist mounting, and
# secure-element readiness so getConfig/getSlots can return a valid key size.
restart_service vendor.weaver_nxp

set_status waiting-init-services
for svc in $CRYPTO_SERVICES; do
    wait_service_running "$svc" 30 || true
done

set_status waiting-binder-services
missing_required=0
for svc in $REQUIRED_BINDER_SERVICES; do
    wait_binder_service "$svc" 45 || missing_required=1
done

if [ "$missing_required" -ne 0 ]; then
    set_status failed
    setprop twrp.decrypt.prereq failed 2>/dev/null || true
    log_msg "required decrypt binder services are not ready; not starting prepdecrypt"
    exit 1
fi

# Let the HALs settle after registration before prepdecrypt and PIN entry.
sleep 2

set_status ready
setprop twrp.decrypt.prereq ready 2>/dev/null || true
log_msg "decrypt prerequisites are ready"

exit 0
