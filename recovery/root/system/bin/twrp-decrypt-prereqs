#!/system/bin/sh

PERSIST_BLOCKS="/dev/block/bootdevice/by-name/persist /dev/block/by-name/persist"
PERSIST_VENDOR_MOUNT="/mnt/vendor/persist"
PERSIST_TWRP_MOUNT="/persist"
SECURE_ELEMENT_BINDER="android.hardware.secure_element.ISecureElement/eSE1"
OMAPI_BINDER="android.se.omapi.ISecureElementService/default"
NFC_BINDER="android.hardware.nfc.INfc/default"
NFC_SERVICE="vendor.nfc_hal_service"
NXP_NCI_MODULES="/tmp/vendor_dlkm/lib/modules/nxp-nci.ko"
NXP_NCI_WAIT_SECONDS=20
LEGACY_NFC_ODM_MOUNT="/tmp/twrp-nfc-odm"
LEGACY_NFC_ODM_BIN="/vendor/odm/bin/hw"
LEGACY_NFC_ODM_LIB="/vendor/odm/lib64"
ACTIVE_VENDOR_MOUNT="/tmp/twrp-crypto-vendor"
ACTIVE_SYSTEM_MOUNT="/tmp/twrp-crypto-system"
ACTIVE_ODM_MOUNT="/tmp/twrp-crypto-odm"
ACTIVE_NFC_CONFIG="/vendor/etc/libnfc-nxp.conf"
ACTIVE_RUNTIME_PROPERTY="twrp.decrypt.runtime"
CRYPTO_SERVICES="vendor.qseecomd vendor.gatekeeper_default vendor.keymint-qti vendor.weaver_nxp keystore2"
REQUIRED_BINDER_SERVICES="android.system.keystore2.IKeystoreService/default android.hardware.gatekeeper.IGatekeeper/default android.hardware.security.keymint.IKeyMintDevice/default android.hardware.weaver.IWeaver/default"

log_msg() {
    echo "[twrp-decrypt] $1"
    echo "[twrp-decrypt] $1" > /dev/kmsg 2>/dev/null || true
}

set_status() {
    setprop twrp.decrypt.status "$1" 2>/dev/null || true
}

fail_prereq() {
    set_status "$1"
    setprop twrp.decrypt.prereq failed 2>/dev/null || true
    log_msg "$2"
    exit 1
}

service_state() {
    getprop "init.svc.$1" 2>/dev/null
}

start_service() {
    svc="$1"
    state="$(service_state "$svc")"
    case "$state" in
        running|restarting)
            log_msg "$svc already $state"
            return 0
            ;;
    esac

    log_msg "starting $svc"
    setprop ctl.start "$svc" 2>/dev/null || true
}

stop_service() {
    svc="$1"
    state="$(service_state "$svc")"
    case "$state" in
        running|restarting|starting)
            log_msg "stopping $svc"
            setprop ctl.stop "$svc" 2>/dev/null || true
            ;;
        *)
            return 0
            ;;
    esac

    count=0
    while [ "$count" -lt 10 ]; do
        state="$(service_state "$svc")"
        case "$state" in
            stopped|"") return 0 ;;
        esac
        sleep 1
        count=$((count + 1))
    done

    log_msg "$svc did not stop cleanly; continuing"
    return 1
}

restart_service() {
    svc="$1"
    stop_service "$svc" || true
    start_service "$svc"
}

wait_service_running() {
    svc="$1"
    timeout="$2"
    count=0

    while [ "$count" -lt "$timeout" ]; do
        [ "$(service_state "$svc")" = "running" ] && return 0
        sleep 1
        count=$((count + 1))
    done

    log_msg "$svc not running after ${timeout}s"
    return 1
}

wait_property() {
    name="$1"
    expected="$2"
    timeout="$3"
    count=0

    while [ "$count" -lt "$timeout" ]; do
        [ "$(getprop "$name" 2>/dev/null)" = "$expected" ] && return 0
        sleep 1
        count=$((count + 1))
    done

    return 1
}

binder_service_available() {
    # The recovery image intentionally omits Android's general service utility.
    # Check Binder directly: process state alone does not prove registration.
    [ -x /system/bin/twrp-service-check ] || return 1
    /system/bin/twrp-service-check "$1" >/dev/null 2>&1
}

wait_binder_service() {
    name="$1"
    timeout="$2"
    count=0

    while [ "$count" -lt "$timeout" ]; do
        binder_service_available "$name" && {
            log_msg "binder ready: $name"
            return 0
        }
        sleep 1
        count=$((count + 1))
    done

    log_msg "binder service not ready after ${timeout}s: $name"
    return 1
}

# Binder registration proves only that the service process exists.  Android's
# vold needs a working eSE-backed Weaver transport, so probe its public,
# credential-free getConfig call before accepting a PIN.
weaver_config_available() {
    [ -x /system/bin/twrp-service-check ] || return 1
    /system/bin/twrp-service-check --weaver-config >/dev/null 2>&1
}

wait_weaver_config() {
    timeout="$1"
    count=0

    while [ "$count" -lt "$timeout" ]; do
        weaver_config_available && {
            log_msg "weaver transport is functional"
            return 0
        }
        sleep 1
        count=$((count + 1))
    done

    log_msg "weaver transport did not return a valid configuration after ${timeout}s"
    return 1
}

nxp_nci_loaded() {
    [ -d /sys/module/nxp_nci ] || grep -q '^nxp_nci ' /proc/modules 2>/dev/null
}

wait_nxp_nci_module() {
    count=0

    while [ "$count" -lt "$NXP_NCI_WAIT_SECONDS" ]; do
        for module in $NXP_NCI_MODULES; do
            [ -r "$module" ] && return 0
        done
        sleep 1
        count=$((count + 1))
    done

    return 1
}

# Use the active slot's module so a custom GKI kernel receives the exact
# vendor_dlkm companion selected by the running firmware.  The recovery
# Wi-Fi loader may finish its vendor_dlkm mount shortly after this helper
# begins, so wait for that exact file instead of racing it.  Do not treat a
# legacy character device as readiness; the NFC Binder check below is the
# functional gate.
load_nxp_nci_module() {
    nxp_nci_loaded && {
        log_msg "NXP NFC transport already loaded"
        return 0
    }

    if ! wait_nxp_nci_module; then
        log_msg "NXP NFC transport module was unavailable after ${NXP_NCI_WAIT_SECONDS}s"
        return 0
    fi

    for module in $NXP_NCI_MODULES; do
        [ -r "$module" ] || continue
        log_msg "loading NXP NFC transport from $module"
        if insmod "$module" 2>/tmp/twrp-nxp-nci.err; then
            sleep 1
            nxp_nci_loaded && {
                log_msg "NXP NFC transport loaded"
                return 0
            }
        fi
        log_msg "NXP NFC transport load failed from $module: $(cat /tmp/twrp-nxp-nci.err 2>/dev/null)"
    done

    log_msg "NXP NFC transport was not loaded; NFC HAL readiness will decide"
    return 0
}

is_mounted() {
    target="$1"
    grep -q " $target " /proc/mounts 2>/dev/null
}

active_slot_suffix() {
    slot_suffix="$(getprop ro.boot.slot_suffix 2>/dev/null)"
    case "$slot_suffix" in
        _a|_b)
            echo "$slot_suffix"
            return 0
            ;;
        *)
            log_msg "invalid active slot suffix: $slot_suffix"
            return 1
            ;;
    esac
}

active_partition_block() {
    partition="$1"
    slot_suffix="$(active_slot_suffix)" || return 1

    for block in \
        "/dev/block/mapper/${partition}${slot_suffix}" \
        "/dev/block/bootdevice/by-name/${partition}${slot_suffix}" \
        "/dev/block/by-name/${partition}${slot_suffix}"; do
        [ -e "$block" ] && {
            echo "$block"
            return 0
        }
    done

    log_msg "active ${partition} block device is unavailable"
    return 1
}

# Dynamic partitions are ext4 on some firmware builds and EROFS on others.
# Mount only the active slot and keep the payload read-only in either case.
mount_active_partition() {
    partition="$1"
    mountpoint="$2"

    mkdir -p "$mountpoint" 2>/dev/null || true
    is_mounted "$mountpoint" && return 0

    block="$(active_partition_block "$partition")" || return 1
    log_msg "mounting active ${partition} from $block"
    mount -t erofs -o ro "$block" "$mountpoint" 2>"/tmp/twrp-crypto-${partition}-mount.err" && return 0
    mount -t ext4 -o ro "$block" "$mountpoint" 2>"/tmp/twrp-crypto-${partition}-mount.err" && return 0

    log_msg "failed mounting active ${partition}: $(cat "/tmp/twrp-crypto-${partition}-mount.err" 2>/dev/null)"
    return 1
}

bind_active_file() {
    source="$1"
    target="$2"

    [ -r "$source" ] || return 1
    is_mounted "$target" && return 0
    mkdir -p "$(dirname "$target")" 2>/dev/null || true
    [ -e "$target" ] || : > "$target" || return 1

    mount -o bind "$source" "$target" 2>/tmp/twrp-crypto-bind.err && return 0
    log_msg "failed binding $source to $target: $(cat /tmp/twrp-crypto-bind.err 2>/dev/null)"
    return 1
}

# LineageOS 24 keeps the current NXP HAL and Weaver binary in vendor, while
# the matching secure-element service remains in ODM.  They use a newer C++/
# Binder ABI than the bundled OxygenOS services, so twrp-active-hal runs them
# through the isolated linker configuration packaged with recovery.
prepare_lineage_active_runtime() {
    mount_active_partition vendor "$ACTIVE_VENDOR_MOUNT" || return 1
    mount_active_partition system "$ACTIVE_SYSTEM_MOUNT" || return 1
    mount_active_partition odm "$ACTIVE_ODM_MOUNT" || return 1

    [ -x "$ACTIVE_VENDOR_MOUNT/bin/hw/android.hardware.nfc-service.nxp" ] || return 1
    [ -r "$ACTIVE_VENDOR_MOUNT/lib64/nfc_nci_nxp_snxxx.so" ] || return 1
    [ -r "$ACTIVE_VENDOR_MOUNT/etc/libnfc-nci.conf" ] || return 1
    [ -x "$ACTIVE_VENDOR_MOUNT/bin/hw/android.hardware.weaver-service.nxp" ] || return 1
    [ -x "$ACTIVE_ODM_MOUNT/bin/hw/android.hardware.secure_element-service.qti" ] || return 1
    [ -r "$ACTIVE_SYSTEM_MOUNT/system/lib64/libbinder_ndk.so" ] || return 1

    bind_active_file "$ACTIVE_VENDOR_MOUNT/etc/libnfc-nci.conf" "$ACTIVE_NFC_CONFIG" || return 1
    setprop "$ACTIVE_RUNTIME_PROPERTY" lineage 2>/dev/null || true
    log_msg "active Lineage NFC, secure-element, and Weaver payload is ready"
    return 0
}

bind_nfc_odm_directory() {
    source="$1"
    target="$2"

    is_mounted "$target" && return 0
    mount -o bind "$source" "$target" 2>/tmp/twrp-nfc-odm-bind.err && return 0

    log_msg "failed binding $source to $target: $(cat /tmp/twrp-nfc-odm-bind.err 2>/dev/null)"
    return 1
}

# OxygenOS 16 keeps the older NXP stack entirely in ODM.  Preserve this
# fallback for existing firmware while LineageOS uses the active runtime above.
mount_active_nfc_odm() {
    mount_active_partition odm "$LEGACY_NFC_ODM_MOUNT" || return 1

    [ -x "$LEGACY_NFC_ODM_MOUNT/bin/hw/android.hardware.nfc-service.nxp" ] || {
        log_msg "active ODM is missing the NXP NFC HAL"
        return 1
    }
    [ -r "$LEGACY_NFC_ODM_MOUNT/lib64/nfc_nci.nqx.default.hw.so" ] || {
        log_msg "active ODM is missing the NXP NFC transport library"
        return 1
    }

    bind_nfc_odm_directory "$LEGACY_NFC_ODM_MOUNT/bin/hw" "$LEGACY_NFC_ODM_BIN" || return 1
    bind_nfc_odm_directory "$LEGACY_NFC_ODM_MOUNT/lib64" "$LEGACY_NFC_ODM_LIB" || return 1
    log_msg "active NFC ODM payload is ready"
    return 0
}

prepare_active_nfc_runtime() {
    setprop "$ACTIVE_RUNTIME_PROPERTY" legacy 2>/dev/null || true
    if prepare_lineage_active_runtime; then
        return 0
    fi

    log_msg "active Lineage runtime was not detected; trying legacy OxygenOS ODM payload"
    mount_active_nfc_odm || return 1
    setprop "$ACTIVE_RUNTIME_PROPERTY" legacy 2>/dev/null || true
    return 0
}

find_persist_block() {
    for block in $PERSIST_BLOCKS; do
        [ -e "$block" ] && echo "$block" && return 0
    done
    return 1
}

bind_persist_mount() {
    src="$1"
    dst="$2"

    is_mounted "$dst" && return 0
    mkdir -p "$dst" 2>/dev/null || true

    log_msg "binding $src to $dst"
    mount -o bind "$src" "$dst" 2>/tmp/twrp-persist-bind.err && return 0

    log_msg "failed binding $src to $dst: $(cat /tmp/twrp-persist-bind.err 2>/dev/null)"
    return 1
}

mount_persist() {
    mkdir -p "$PERSIST_VENDOR_MOUNT" "$PERSIST_TWRP_MOUNT" 2>/dev/null || true

    if is_mounted "$PERSIST_VENDOR_MOUNT"; then
        log_msg "$PERSIST_VENDOR_MOUNT already mounted"
        bind_persist_mount "$PERSIST_VENDOR_MOUNT" "$PERSIST_TWRP_MOUNT" || true
    elif is_mounted "$PERSIST_TWRP_MOUNT"; then
        log_msg "$PERSIST_TWRP_MOUNT already mounted"
        bind_persist_mount "$PERSIST_TWRP_MOUNT" "$PERSIST_VENDOR_MOUNT" || true
    else
        count=0
        block=""
        while [ "$count" -lt 10 ]; do
            block="$(find_persist_block)" && break
            sleep 1
            count=$((count + 1))
        done

        if [ -z "$block" ]; then
            log_msg "persist block device not found"
            return 1
        fi

        log_msg "mounting $PERSIST_VENDOR_MOUNT from $block"
        if ! mount -t ext4 -o noatime,nosuid,nodev,barrier=1 "$block" "$PERSIST_VENDOR_MOUNT" 2>/tmp/twrp-persist-mount.err; then
            mount -t ext4 "$block" "$PERSIST_VENDOR_MOUNT" 2>/tmp/twrp-persist-mount.err || {
                log_msg "failed to mount $PERSIST_VENDOR_MOUNT: $(cat /tmp/twrp-persist-mount.err 2>/dev/null)"
                return 1
            }
        fi

        bind_persist_mount "$PERSIST_VENDOR_MOUNT" "$PERSIST_TWRP_MOUNT" || {
            log_msg "bind mount failed; mounting persist directly at $PERSIST_TWRP_MOUNT"
            mount -t ext4 "$block" "$PERSIST_TWRP_MOUNT" 2>/tmp/twrp-persist-mount.err || true
        }
    fi

    if ! is_mounted "$PERSIST_VENDOR_MOUNT"; then
        log_msg "$PERSIST_VENDOR_MOUNT is not mounted after setup"
        return 1
    fi

    if ! is_mounted "$PERSIST_TWRP_MOUNT"; then
        log_msg "$PERSIST_TWRP_MOUNT is not mounted after setup"
        return 1
    fi

    log_msg "persist ready at $PERSIST_VENDOR_MOUNT and $PERSIST_TWRP_MOUNT"
    return 0
}

setprop twrp.decrypt.prereq preparing 2>/dev/null || true
set_status preparing
[ "$(getprop twrp.fstab.ready)" = "1" ] || fail_prereq vendor-not-ready "temporary vendor mounts are not released"
[ -x /system/bin/twrp-service-check ] || fail_prereq binder-check-missing "Binder readiness checker is missing"
mount_persist || fail_prereq persist-mount-failed "persist mount setup failed; not starting decrypt services"

# The NXP services reject requests while Android reports boot incomplete.
setprop sys.boot_completed 1 2>/dev/null || true
wait_property sys.boot_completed 1 5 || log_msg "sys.boot_completed did not settle"

# FBE Weaver on this device reaches the eSE through the NXP NFC HAL. Load the
# active-slot NCI transport before choosing a userspace layout: LineageOS does
# not place the NFC HAL in the legacy ODM location, and the old ordering
# otherwise aborts before the signed active module can create /dev/nq-nci.
set_status loading-nfc-transport
load_nxp_nci_module

set_status starting-nfc
prepare_active_nfc_runtime || fail_prereq nfc-runtime-unavailable "no compatible active NFC runtime was found"
restart_service "$NFC_SERVICE"
wait_service_running "$NFC_SERVICE" 20 || fail_prereq nfc-hal-failed "NFC HAL did not become ready"
wait_binder_service "$NFC_BINDER" 45 || fail_prereq nfc-binder-failed "NFC HAL Binder service did not become ready"
sleep 2

set_status preparing-secure-element
start_service vendor.qseecomd
wait_service_running vendor.qseecomd 20 || fail_prereq qseecomd-failed "vendor.qseecomd did not become ready"
start_service vendor.ssgtzd
wait_service_running vendor.ssgtzd 20 || true

# Both daemons may already be running with a cached failed eSE probe. Stop the
# OMAPI client first, then reinitialize the HAL after persist/QSEE readiness.
set_status restarting-secure-element
stop_service se_omapi || true
stop_service vendor.secure_element || true
sleep 1
start_service vendor.secure_element
wait_service_running vendor.secure_element 20 || fail_prereq secure-element-failed "vendor.secure_element did not become ready"
wait_binder_service "$SECURE_ELEMENT_BINDER" 30 || fail_prereq secure-element-binder-failed "secure-element binder did not become ready"

# Allow the HAL's chip/vendor detection and trusted-app initialization to finish
# before OMAPI opens a reader.
sleep 6

set_status restarting-omapi
start_service se_omapi
wait_service_running se_omapi 20 || fail_prereq omapi-failed "se_omapi did not become ready"
wait_binder_service "$OMAPI_BINDER" 30 || fail_prereq omapi-binder-failed "OMAPI binder did not become ready"
sleep 2

set_status starting-crypto-services
for svc in vendor.gatekeeper_default vendor.keymint-qti keystore2; do
    start_service "$svc"
done

# Restart Weaver only after the refreshed eSE and OMAPI services are available.
restart_service vendor.weaver_nxp

set_status waiting-init-services
for svc in $CRYPTO_SERVICES; do
    wait_service_running "$svc" 30 || true
done

set_status waiting-binder-services
missing_required=0
for svc in $REQUIRED_BINDER_SERVICES; do
    wait_binder_service "$svc" 45 || missing_required=1
done

if [ "$missing_required" -ne 0 ]; then
    fail_prereq failed "required decrypt binder services are not ready; not starting prepdecrypt"
fi

wait_weaver_config 45 || fail_prereq weaver-config-failed "Weaver eSE transport is unavailable; do not submit a credential"

# Let the HALs settle after registration before prepdecrypt and PIN entry.
sleep 2

set_status ready
setprop twrp.decrypt.prereq ready 2>/dev/null || true
log_msg "decrypt prerequisites are ready"

exit 0
