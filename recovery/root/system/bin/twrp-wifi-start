#!/system/bin/sh

IFACE="wlan0"
SOCKET_DIR="/tmp/recovery/sockets"
VENDOR_DLKM_MOUNT="/tmp/vendor_dlkm"
WIFI_VENDOR_MOUNT="/tmp/twrp-wifi-vendor"
WIFI_ODM_MOUNT="/tmp/twrp-wifi-odm"
WIFI_RUNTIME_FIRMWARE="/tmp/twrp-wifi-firmware"
MODULE_DIRS="/system/lib/modules /vendor/lib/modules /vendor_dlkm/lib/modules /lib/modules"
WPA_CLI="/system/bin/wpa_cli"
DNS_PUBLISHER="/system/bin/twrp-dns-publish"
MODEM_PEACH_FIRMWARE="/firmware/image/peach"

log_msg() {
    echo "[twrp-wifi] $1"
    echo "[twrp-wifi] $1" > /dev/kmsg 2>/dev/null || true
}

set_status() {
    setprop twrp.wifi.status "$1" 2>/dev/null || true
}

set_ready() {
    setprop wifi.driver.ready "$1" 2>/dev/null || true
}

prepare_fallback_dns() {
    if [ ! -x "$DNS_PUBLISHER" ]; then
        log_msg "DNS publisher is missing or not executable: $DNS_PUBLISHER"
        setprop twrp.wifi.dns.ready 0 2>/dev/null || true
        return 1
    fi

    setprop twrp.wifi.dns1 1.1.1.1 2>/dev/null || true
    setprop twrp.wifi.dns2 8.8.8.8 2>/dev/null || true

    "$DNS_PUBLISHER" "$IFACE" >/tmp/twrp-dns-preinit.log 2>&1 || {
        log_msg "fallback DNS initialization failed: $(cat /tmp/twrp-dns-preinit.log 2>/dev/null)"
        setprop twrp.wifi.dns.ready 0 2>/dev/null || true
        return 1
    }

    if [ "$(getprop twrp.wifi.dns.ready 2>/dev/null)" = "1" ]; then
        log_msg "fallback DNS resolver initialized before DHCP"
        return 0
    fi

    log_msg "fallback DNS publisher returned without setting ready state"
    return 1
}

module_name() {
    echo "${1%.ko}" | tr '-' '_'
}

# Recovery shell variables are global across functions. Keep temporary module
# names in subshells so normalizing a loaded-module name cannot overwrite the
# original .ko filename used for the filesystem lookup.
module_loaded() (
    mod="$(module_name "$1")"
    grep -q "^${mod} " /proc/modules 2>/dev/null
)

find_module() (
    mod="$1"
    for dir in $MODULE_DIRS; do
        if [ -f "$dir/$mod" ]; then
            echo "$dir/$mod"
            return 0
        fi
    done
    return 1
)

load_module() {
    mod="$1"

    if module_loaded "$mod"; then
        log_msg "$mod already loaded"
        return 0
    fi

    path="$(find_module "$mod")" || {
        log_msg "missing module: $mod"
        return 1
    }

    log_msg "loading $path"
    insmod "$path" 2>/tmp/twrp-wifi-insmod.err && return 0

    if module_loaded "$mod"; then
        log_msg "$mod loaded despite insmod warning"
        return 0
    fi

    log_msg "failed loading $mod: $(cat /tmp/twrp-wifi-insmod.err 2>/dev/null)"
    return 1
}

is_mounted() (
    target="$1"
    awk -v target="$target" '$2 == target { found = 1; exit } END { exit !found }' \
        /proc/mounts 2>/dev/null
)

find_vendor_dlkm_block() (
    slot="$(getprop ro.boot.slot_suffix 2>/dev/null)"
    for block in \
        "/dev/block/mapper/vendor_dlkm${slot}" \
        "/dev/block/mapper/vendor_dlkm" \
        "/dev/block/by-name/vendor_dlkm${slot}" \
        "/dev/block/by-name/vendor_dlkm" \
        "/dev/block/bootdevice/by-name/vendor_dlkm${slot}" \
        "/dev/block/bootdevice/by-name/vendor_dlkm"
    do
        if [ -e "$block" ]; then
            echo "$block"
            return 0
        fi
    done
    return 1
)

mount_vendor_dlkm_modules() {
    # The first filesystem probe can fail even when a later fallback mounts the
    # partition successfully. Do not leave that expected probe output behind
    # as a false Wi-Fi startup failure.
    rm -f /tmp/twrp-wifi-vendor-dlkm.err

    if find_module smem-mailbox.ko >/dev/null 2>&1; then
        return 0
    fi

    mkdir -p "$VENDOR_DLKM_MOUNT" 2>/dev/null || true

    if ! is_mounted "$VENDOR_DLKM_MOUNT"; then
        vdlkm_block="$(find_vendor_dlkm_block)" || {
            log_msg "vendor_dlkm block device not found"
            return 1
        }

        log_msg "mounting vendor_dlkm from $vdlkm_block"
        mount -t erofs -o ro "$vdlkm_block" "$VENDOR_DLKM_MOUNT" 2>/tmp/twrp-wifi-vendor-dlkm.err || \
        mount -t ext4 -o ro "$vdlkm_block" "$VENDOR_DLKM_MOUNT" 2>>/tmp/twrp-wifi-vendor-dlkm.err || \
        mount -o ro "$vdlkm_block" "$VENDOR_DLKM_MOUNT" 2>>/tmp/twrp-wifi-vendor-dlkm.err || {
            log_msg "failed mounting vendor_dlkm: $(cat /tmp/twrp-wifi-vendor-dlkm.err 2>/dev/null)"
            return 1
        }
    fi

    if [ ! -d "$VENDOR_DLKM_MOUNT/lib/modules" ]; then
        log_msg "vendor_dlkm module directory missing after mount"
        return 1
    fi

    MODULE_DIRS="$VENDOR_DLKM_MOUNT/lib/modules $MODULE_DIRS"
    log_msg "vendor_dlkm modules ready at $VENDOR_DLKM_MOUNT/lib/modules"

    if [ ! -f "$VENDOR_DLKM_MOUNT/lib/modules/smem-mailbox.ko" ]; then
        log_msg "smem-mailbox.ko missing from mounted vendor_dlkm"
        return 1
    fi

    rm -f /tmp/twrp-wifi-vendor-dlkm.err
    return 0
}

find_active_partition_block() {
    partition="$1"
    slot_suffix="$(getprop ro.boot.slot_suffix 2>/dev/null)"

    case "$slot_suffix" in
        _a|_b) ;;
        *)
            log_msg "invalid active slot suffix for $partition: $slot_suffix"
            return 1
            ;;
    esac

    for block in \
        "/dev/block/mapper/${partition}${slot_suffix}" \
        "/dev/block/by-name/${partition}${slot_suffix}" \
        "/dev/block/bootdevice/by-name/${partition}${slot_suffix}"
    do
        if [ -e "$block" ]; then
            echo "$block"
            return 0
        fi
    done

    return 1
}

mount_active_partition_readonly() {
    partition="$1"
    target="$2"
    err="/tmp/twrp-wifi-${partition}-mount.err"

    mkdir -p "$target" 2>/dev/null || true
    is_mounted "$target" && return 0

    block="$(find_active_partition_block "$partition")" || {
        log_msg "active $partition block device is unavailable"
        return 1
    }

    rm -f "$err"
    log_msg "mounting active $partition from $block"
    mount -t erofs -o ro "$block" "$target" 2>"$err" || \
    mount -t ext4 -o ro "$block" "$target" 2>>"$err" || \
    mount -o ro "$block" "$target" 2>>"$err" || {
        log_msg "failed mounting active $partition: $(cat "$err" 2>/dev/null)"
        return 1
    }

    return 0
}

bind_readonly_directory() {
    src="$1"
    dst="$2"

    [ -d "$src" ] || {
        log_msg "runtime firmware source is missing: $src"
        return 1
    }

    mkdir -p "$dst" 2>/dev/null || true
    is_mounted "$dst" && return 0

    mount -o bind "$src" "$dst" 2>/tmp/twrp-wifi-bind.err || {
        log_msg "failed binding $src to $dst: $(cat /tmp/twrp-wifi-bind.err 2>/dev/null)"
        return 1
    }
    # Sources are read-only physical partitions, but explicitly retain that
    # property at the bind target as a defense against future layout changes.
    mount -o remount,bind,ro "$dst" 2>/dev/null || true
    return 0
}

link_firmware_tree() {
    src="$1"
    dst="$2"
    linked=0

    [ -d "$src" ] || return 1
    for entry in "$src"/*; do
        [ -f "$entry" ] || continue
        ln -sf "$entry" "$dst/${entry##*/}" || return 1
        linked=$((linked + 1))
    done

    [ "$linked" -gt 0 ]
}

prepare_runtime_peach_view() {
    peach_runtime="$WIFI_RUNTIME_FIRMWARE/peach"

    mkdir -p "$WIFI_RUNTIME_FIRMWARE" 2>/dev/null || true
    if ! is_mounted "$WIFI_RUNTIME_FIRMWARE"; then
        mount -t tmpfs -o mode=0755,size=256k tmpfs "$WIFI_RUNTIME_FIRMWARE" \
            2>/tmp/twrp-wifi-runtime-mount.err || {
            log_msg "failed mounting Wi-Fi runtime link view: $(cat /tmp/twrp-wifi-runtime-mount.err 2>/dev/null)"
            return 1
        }
    fi

    mkdir -p "$peach_runtime" 2>/dev/null || true
    # The view is sealed after its first complete construction.  On a later
    # property-triggered invocation, reuse it instead of attempting to modify
    # a read-only tmpfs mount.
    if [ -r "$peach_runtime/amss20.bin" ] && \
       [ -r "$peach_runtime/bdwlan.b0a" ] && \
       [ -r "$peach_runtime/regdb.bin" ]; then
        return 0
    fi

    [ -w "$peach_runtime" ] || {
        log_msg "Wi-Fi runtime link view is incomplete and not writable"
        return 1
    }

    rm -f "$peach_runtime"/* 2>/dev/null || true
    link_firmware_tree "$MODEM_PEACH_FIRMWARE" "$peach_runtime" || {
        log_msg "active modem Peach firmware has no usable files"
        return 1
    }
    # The active ODM versions override the modem copy when a board-specific
    # name overlaps (notably BDF and regulatory data).
    link_firmware_tree "$WIFI_ODM_MOUNT/etc/wifi/peach" "$peach_runtime" || {
        log_msg "active ODM Peach firmware has no usable files"
        return 1
    }

    [ -r "$peach_runtime/amss20.bin" ] && \
    [ -r "$peach_runtime/bdwlan.b0a" ] && \
    [ -r "$peach_runtime/regdb.bin" ] || {
        log_msg "linked Peach firmware view is incomplete"
        return 1
    }

    mount -o remount,ro "$WIFI_RUNTIME_FIRMWARE" 2>/tmp/twrp-wifi-runtime-mount.err || {
        log_msg "failed sealing Wi-Fi runtime link view read-only: $(cat /tmp/twrp-wifi-runtime-mount.err 2>/dev/null)"
        return 1
    }
    return 0
}

# The modem partition provides the bulk of Peach firmware, while the active
# ODM partition supplies the board-specific BDF and regulatory files.  Build
# a tiny symlink view with ODM taking precedence, then bind it at every legacy
# firmware location that the CNSS driver may query.  This keeps recovery in
# lock-step with the selected slot without storing a second copy in the image.
prepare_wlan_firmware() {
    set_status staging-firmware

    mount_active_partition_readonly vendor "$WIFI_VENDOR_MOUNT" || return 1
    mount_active_partition_readonly odm "$WIFI_ODM_MOUNT" || return 1
    [ -d "$MODEM_PEACH_FIRMWARE" ] || {
        log_msg "active modem Peach firmware is unavailable: $MODEM_PEACH_FIRMWARE"
        return 1
    }
    [ -d "$WIFI_VENDOR_MOUNT/etc/wifi" ] || {
        log_msg "active vendor Wi-Fi configuration is unavailable"
        return 1
    }
    [ -d "$WIFI_ODM_MOUNT/etc/wifi" ] || {
        log_msg "active ODM Wi-Fi configuration is unavailable"
        return 1
    }

    bind_readonly_directory "$WIFI_VENDOR_MOUNT/etc/wifi" /vendor/etc/wifi || return 1
    bind_readonly_directory "$WIFI_ODM_MOUNT/etc/wifi" /vendor/odm/etc/wifi || return 1
    # Some firmware loaders use the traditional /odm path while recovery
    # userspace uses /vendor/odm.  Point both at the active slot's directory.
    bind_readonly_directory "$WIFI_ODM_MOUNT/etc/wifi" /odm/etc/wifi || return 1

    prepare_runtime_peach_view || return 1

    for dst in /lib/firmware/peach /vendor/firmware/peach /vendor/odm/firmware/peach; do
        bind_readonly_directory "$peach_runtime" "$dst" || return 1
    done

    setprop twrp.wifi.firmware active-slot 2>/dev/null || true
    log_msg "using linked active-slot modem, vendor, and ODM Wi-Fi firmware"
    return 0
}

set_fs_ready() {
    for node in /sys/bus/platform/drivers/cnss2/*/fs_ready; do
        [ -e "$node" ] || continue
        chmod 222 "$node" 2>/dev/null || true
        echo 1 > "$node" 2>/dev/null && log_msg "set $node=1"
    done
}

wait_for_wlan0() {
    count=0
    while [ "$count" -lt 60 ]; do
        [ -d "/sys/class/net/$IFACE" ] && return 0
        sleep 1
        count=$((count + 1))
    done
    return 1
}

wait_for_supplicant() {
    count=0
    while [ "$count" -lt 20 ]; do
        "$WPA_CLI" -i "$IFACE" -p "$SOCKET_DIR" ping 2>/dev/null | grep -q PONG && return 0
        sleep 1
        count=$((count + 1))
    done
    return 1
}

set_ready false
set_status preparing
mkdir -p /tmp/recovery "$SOCKET_DIR" /firmware 2>/dev/null || true
chmod 0777 /tmp/recovery "$SOCKET_DIR" 2>/dev/null || true
prepare_fallback_dns || true

mount | grep -q " /firmware " || mount -t vfat -o ro "/dev/block/bootdevice/by-name/modem$(getprop ro.boot.slot_suffix)" /firmware 2>/dev/null || true

echo 1 > /proc/sys/kernel/firmware_config/force_sysfs_fallback 2>/dev/null || true
if ! prepare_wlan_firmware; then
    set_status firmware-link-failed
    set_ready false
    log_msg "Wi-Fi firmware links are not ready; not loading the WLAN driver"
    exit 0
fi
mount_vendor_dlkm_modules || true

set_status loading-cnss
for mod in qmi_helpers.ko cnss_prealloc.ko smem-mailbox.ko cnss_utils.ko cnss_plat_ipc_qmi_svc.ko cnss_nl.ko wlan_firmware_service.ko cnss2.ko; do
    load_module "$mod" || true
done

set_fs_ready
sleep 1

set_status loading-wlan-deps
for mod in rmnet_mem.ko gsim.ko ipam.ko rfkill.ko cfg80211.ko; do
    load_module "$mod" || true
done

set_fs_ready
sleep 1

set_status loading-wlan-driver
load_module qca_cld3_peach_v2.ko || true
set_fs_ready

set_status waiting-wlan0
if ! wait_for_wlan0; then
    set_status wlan0-missing
    set_ready false
    log_msg "wlan0 did not appear"
    exit 0
fi

ifconfig "$IFACE" up 2>/dev/null || true

set_status starting-supplicant
stop wpa_supplicant 2>/dev/null || true
sleep 1
start wpa_supplicant

if wait_for_supplicant; then
    set_ready true
    set_status ready
    log_msg "wpa_supplicant is ready"
else
    set_ready false
    set_status supplicant-timeout
    log_msg "wpa_supplicant did not answer PONG"
fi

exit 0
