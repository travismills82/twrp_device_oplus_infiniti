#!/system/bin/sh

IFACE="wlan0"
SOCKET_DIR="/tmp/recovery/sockets"
VENDOR_DLKM_MOUNT="/tmp/vendor_dlkm"
MODULE_DIRS="/system/lib/modules /vendor/lib/modules /vendor_dlkm/lib/modules /lib/modules"
WPA_CLI="/system/bin/wpa_cli"
DNS_PUBLISHER="/system/bin/twrp-dns-publish"
INI_NAME="WCNSS_qcom_cfg.ini"
INI_SOURCES="/vendor/etc/wifi/peach_v2/$INI_NAME /vendor/etc/wifi/peach/$INI_NAME /vendor/odm/etc/wifi/peach_v2/$INI_NAME /vendor/odm/etc/wifi/peach/$INI_NAME"
PEACH_FIRMWARE_SOURCES="/vendor/odm/etc/wifi/peach /vendor/etc/wifi/peach /vendor/odm/firmware/peach /vendor/firmware/peach"
PEACH_FIRMWARE_DESTS="/lib/firmware/peach /vendor/firmware/peach /vendor/odm/firmware/peach"
WLAN_UPDATE_DIR="/data/vendor/firmware/update/wlan"

log_msg() {
    echo "[twrp-wifi] $1"
    echo "[twrp-wifi] $1" > /dev/kmsg 2>/dev/null || true
}

set_status() {
    setprop twrp.wifi.status "$1" 2>/dev/null || true
}

set_ready() {
    setprop wifi.driver.ready "$1" 2>/dev/null || true
}

prepare_fallback_dns() {
    if [ ! -x "$DNS_PUBLISHER" ]; then
        log_msg "DNS publisher is missing or not executable: $DNS_PUBLISHER"
        setprop twrp.wifi.dns.ready 0 2>/dev/null || true
        return 1
    fi

    setprop twrp.wifi.dns1 1.1.1.1 2>/dev/null || true
    setprop twrp.wifi.dns2 8.8.8.8 2>/dev/null || true

    "$DNS_PUBLISHER" "$IFACE" >/tmp/twrp-dns-preinit.log 2>&1 || {
        log_msg "fallback DNS initialization failed: $(cat /tmp/twrp-dns-preinit.log 2>/dev/null)"
        setprop twrp.wifi.dns.ready 0 2>/dev/null || true
        return 1
    }

    if [ "$(getprop twrp.wifi.dns.ready 2>/dev/null)" = "1" ]; then
        log_msg "fallback DNS resolver initialized before DHCP"
        return 0
    fi

    log_msg "fallback DNS publisher returned without setting ready state"
    return 1
}

module_name() {
    echo "${1%.ko}" | tr '-' '_'
}

# Recovery shell variables are global across functions. Keep temporary module
# names in subshells so normalizing a loaded-module name cannot overwrite the
# original .ko filename used for the filesystem lookup.
module_loaded() (
    mod="$(module_name "$1")"
    grep -q "^${mod} " /proc/modules 2>/dev/null
)

find_module() (
    mod="$1"
    for dir in $MODULE_DIRS; do
        if [ -f "$dir/$mod" ]; then
            echo "$dir/$mod"
            return 0
        fi
    done
    return 1
)

load_module() {
    mod="$1"

    if module_loaded "$mod"; then
        log_msg "$mod already loaded"
        return 0
    fi

    path="$(find_module "$mod")" || {
        log_msg "missing module: $mod"
        return 1
    }

    log_msg "loading $path"
    insmod "$path" 2>/tmp/twrp-wifi-insmod.err && return 0

    if module_loaded "$mod"; then
        log_msg "$mod loaded despite insmod warning"
        return 0
    fi

    log_msg "failed loading $mod: $(cat /tmp/twrp-wifi-insmod.err 2>/dev/null)"
    return 1
}

is_mounted() (
    target="$1"
    grep -q " $target " /proc/mounts 2>/dev/null
)

find_vendor_dlkm_block() (
    slot="$(getprop ro.boot.slot_suffix 2>/dev/null)"
    for block in \
        "/dev/block/mapper/vendor_dlkm${slot}" \
        "/dev/block/mapper/vendor_dlkm" \
        "/dev/block/by-name/vendor_dlkm${slot}" \
        "/dev/block/by-name/vendor_dlkm" \
        "/dev/block/bootdevice/by-name/vendor_dlkm${slot}" \
        "/dev/block/bootdevice/by-name/vendor_dlkm"
    do
        if [ -e "$block" ]; then
            echo "$block"
            return 0
        fi
    done
    return 1
)

mount_vendor_dlkm_modules() {
    if find_module smem-mailbox.ko >/dev/null 2>&1; then
        return 0
    fi

    mkdir -p "$VENDOR_DLKM_MOUNT" 2>/dev/null || true

    if ! is_mounted "$VENDOR_DLKM_MOUNT"; then
        vdlkm_block="$(find_vendor_dlkm_block)" || {
            log_msg "vendor_dlkm block device not found"
            return 1
        }

        log_msg "mounting vendor_dlkm from $vdlkm_block"
        mount -t erofs -o ro "$vdlkm_block" "$VENDOR_DLKM_MOUNT" 2>/tmp/twrp-wifi-vendor-dlkm.err || \
        mount -t ext4 -o ro "$vdlkm_block" "$VENDOR_DLKM_MOUNT" 2>>/tmp/twrp-wifi-vendor-dlkm.err || \
        mount -o ro "$vdlkm_block" "$VENDOR_DLKM_MOUNT" 2>>/tmp/twrp-wifi-vendor-dlkm.err || {
            log_msg "failed mounting vendor_dlkm: $(cat /tmp/twrp-wifi-vendor-dlkm.err 2>/dev/null)"
            return 1
        }
    fi

    if [ ! -d "$VENDOR_DLKM_MOUNT/lib/modules" ]; then
        log_msg "vendor_dlkm module directory missing after mount"
        return 1
    fi

    MODULE_DIRS="$VENDOR_DLKM_MOUNT/lib/modules $MODULE_DIRS"
    log_msg "vendor_dlkm modules ready at $VENDOR_DLKM_MOUNT/lib/modules"

    if [ ! -f "$VENDOR_DLKM_MOUNT/lib/modules/smem-mailbox.ko" ]; then
        log_msg "smem-mailbox.ko missing from mounted vendor_dlkm"
        return 1
    fi

    return 0
}

copy_file_if_present() {
    src="$1"
    dst="$2"

    [ -f "$src" ] || return 1
    mkdir -p "${dst%/*}" 2>/dev/null || true
    cp -f "$src" "$dst" 2>/tmp/twrp-wifi-copy.err && {
        chmod 0644 "$dst" 2>/dev/null || true
        log_msg "copied $src -> $dst"
        return 0
    }

    log_msg "failed copying $src -> $dst: $(cat /tmp/twrp-wifi-copy.err 2>/dev/null)"
    return 1
}

copy_dir_contents_if_present() {
    src="$1"
    dst="$2"

    [ -d "$src" ] || return 1
    [ "$src" = "$dst" ] && return 0

    mkdir -p "$dst" 2>/dev/null || true
    cp -af "$src"/. "$dst"/ 2>/tmp/twrp-wifi-copy.err && {
        log_msg "copied peach firmware $src -> $dst"
        return 0
    }

    log_msg "failed copying peach firmware $src -> $dst: $(cat /tmp/twrp-wifi-copy.err 2>/dev/null)"
    return 1
}

prepare_wlan_firmware() {
    set_status staging-firmware
    mkdir -p "$WLAN_UPDATE_DIR" 2>/dev/null || true
    chmod 0755 /data /data/vendor /data/vendor/firmware /data/vendor/firmware/update "$WLAN_UPDATE_DIR" 2>/dev/null || true

    ini_src=""
    for src in $INI_SOURCES; do
        if [ -f "$src" ]; then
            ini_src="$src"
            break
        fi
    done

    if [ -n "$ini_src" ]; then
        copy_file_if_present "$ini_src" "$WLAN_UPDATE_DIR/$INI_NAME" || true
        for dst in $PEACH_FIRMWARE_DESTS; do
            copy_file_if_present "$ini_src" "$dst/$INI_NAME" || true
        done
    else
        log_msg "$INI_NAME not found in known recovery paths"
    fi

    peach_src=""
    for src in $PEACH_FIRMWARE_SOURCES; do
        if [ -d "$src" ]; then
            peach_src="$src"
            break
        fi
    done

    if [ -n "$peach_src" ]; then
        for dst in $PEACH_FIRMWARE_DESTS; do
            copy_dir_contents_if_present "$peach_src" "$dst" || true
        done
    else
        log_msg "peach firmware directory not found in known recovery paths"
    fi
}

set_fs_ready() {
    for node in /sys/bus/platform/drivers/cnss2/*/fs_ready; do
        [ -e "$node" ] || continue
        chmod 222 "$node" 2>/dev/null || true
        echo 1 > "$node" 2>/dev/null && log_msg "set $node=1"
    done
}

wait_for_wlan0() {
    count=0
    while [ "$count" -lt 60 ]; do
        [ -d "/sys/class/net/$IFACE" ] && return 0
        sleep 1
        count=$((count + 1))
    done
    return 1
}

wait_for_supplicant() {
    count=0
    while [ "$count" -lt 20 ]; do
        "$WPA_CLI" -i "$IFACE" -p "$SOCKET_DIR" ping 2>/dev/null | grep -q PONG && return 0
        sleep 1
        count=$((count + 1))
    done
    return 1
}

set_ready false
set_status preparing
mkdir -p /tmp/recovery "$SOCKET_DIR" /firmware 2>/dev/null || true
chmod 0777 /tmp/recovery "$SOCKET_DIR" 2>/dev/null || true
prepare_fallback_dns || true

mount | grep -q " /firmware " || mount -t vfat -o ro "/dev/block/bootdevice/by-name/modem$(getprop ro.boot.slot_suffix)" /firmware 2>/dev/null || true

echo 1 > /proc/sys/kernel/firmware_config/force_sysfs_fallback 2>/dev/null || true
prepare_wlan_firmware
mount_vendor_dlkm_modules || true

set_status loading-cnss
for mod in qmi_helpers.ko cnss_prealloc.ko smem-mailbox.ko cnss_utils.ko cnss_plat_ipc_qmi_svc.ko cnss_nl.ko wlan_firmware_service.ko cnss2.ko; do
    load_module "$mod" || true
done

set_fs_ready
sleep 1

set_status loading-wlan-deps
for mod in rmnet_mem.ko gsim.ko ipam.ko rfkill.ko cfg80211.ko; do
    load_module "$mod" || true
done

set_fs_ready
sleep 1

set_status loading-wlan-driver
load_module qca_cld3_peach_v2.ko || true
set_fs_ready

set_status waiting-wlan0
if ! wait_for_wlan0; then
    set_status wlan0-missing
    set_ready false
    log_msg "wlan0 did not appear"
    exit 0
fi

ifconfig "$IFACE" up 2>/dev/null || true

set_status starting-supplicant
stop wpa_supplicant 2>/dev/null || true
sleep 1
start wpa_supplicant

if wait_for_supplicant; then
    set_ready true
    set_status ready
    log_msg "wpa_supplicant is ready"
else
    set_ready false
    set_status supplicant-timeout
    log_msg "wpa_supplicant did not answer PONG"
fi

exit 0
