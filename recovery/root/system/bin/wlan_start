#!/system/bin/sh

LOG=/tmp/recovery_wifi_diag.log
exec >"$LOG" 2>&1

echo "=== wlan_start diagnostic ==="
echo "This script is diagnostic only. It does not mount partitions, write fs_ready, insmod modules, or start wpa_supplicant."
echo "Use the init-managed Wi-Fi path instead: setprop twrp.wifi.enable 1"
echo

echo "--- identity ---"
id 2>/dev/null || true
id -Z 2>/dev/null || true

echo

echo "--- Wi-Fi props ---"
getprop twrp.wifi.enable 2>/dev/null || true
getprop twrp.wifi.status 2>/dev/null || true
getprop wifi.driver.ready 2>/dev/null || true

echo

echo "--- firmware/config paths ---"
for path in \
    /vendor/etc/wifi/peach_v2/WCNSS_qcom_cfg.ini \
    /vendor/etc/wifi/peach/WCNSS_qcom_cfg.ini \
    /vendor/odm/etc/wifi/peach_v2/WCNSS_qcom_cfg.ini \
    /vendor/odm/etc/wifi/peach/WCNSS_qcom_cfg.ini \
    /data/vendor/firmware/update/wlan/WCNSS_qcom_cfg.ini \
    /lib/firmware/peach/WCNSS_qcom_cfg.ini \
    /vendor/firmware/peach/WCNSS_qcom_cfg.ini \
    /vendor/odm/firmware/peach/WCNSS_qcom_cfg.ini; do
    if [ -e "$path" ]; then
        ls -l "$path" 2>/dev/null || true
    else
        echo "missing: $path"
    fi
done

echo

echo "--- fs_ready nodes ---"
for node in /sys/bus/platform/drivers/cnss2/*/fs_ready; do
    [ -e "$node" ] && ls -l "$node" && cat "$node" 2>/dev/null || true
done

echo

echo "--- loaded wlan modules ---"
cat /proc/modules 2>/dev/null | grep -E 'qca|cnss|cfg80211|wlan|rfkill|qmi|ipam|gsim|rmnet' || true

echo

echo "--- net devices ---"
ls -l /sys/class/net 2>/dev/null || true
cat /proc/net/dev 2>/dev/null || true

echo

echo "--- supplicant sockets ---"
ls -la /tmp/recovery/sockets 2>/dev/null || true

echo

echo "--- dmesg wlan tail ---"
dmesg 2>/dev/null | grep -i 'wpa\|supplicant\|nl80211\|wlan\|qca\|cld3\|cnss\|qmi\|dms\|firmware\|cal\|avc\|selinux' | tail -n 240 || true

echo "diagnostic log written to $LOG"
exit 0
