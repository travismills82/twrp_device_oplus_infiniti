#!/system/bin/sh
# The native browser hands credentials to its client over a private socket.
# Do not re-enable the legacy CIFS mount -o password=... command-line path.
case "${1:-status}" in
    status)
        printf 'Kernel CIFS: '
        if grep -qw cifs /proc/filesystems; then echo available; else echo unavailable; fi
        awk '$5 == "/mnt/smb/share" {print "SMB mount:", $0}' /proc/self/mountinfo
        echo "Connect and disconnect through Advanced > CIFS / SMB Browser."
        ;;
    *)
        echo "Use Advanced > CIFS / SMB Browser to mount or disconnect shares." >&2
        exit 2
        ;;
esac
