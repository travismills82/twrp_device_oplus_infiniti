#!/system/bin/sh
# Compatibility front end for the original boot + system_dlkm workflow.
#
# The implementation now lives in twrp-flash-controlled-stack so both the
# legacy two-image path and a complete controlled stack use one validation,
# backup, write-order, and read-back-verification implementation.

set -u

usage() {
    printf '%s\n' \
        'Usage:' \
        '  twrp-flash-kernel [--dry-run|--flash] [--no-backup]' \
        '      [--backup-dir DIR] BOOT_IMAGE SYSTEM_DLKM_IMAGE' \
        '' \
        'Compatibility front end for twrp-flash-controlled-stack.' \
        'The target is always the slot from which TWRP is currently booted.' \
        'Without --flash, all validation runs but no partition is modified.'
}

fail() {
    echo "[kernel-flash] ERROR: $*"
    exit 1
}

MODE=--dry-run
NO_BACKUP=0
BACKUP_ROOT=/sdcard/TWRP/kernel-flash-backups

while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run) MODE=--dry-run ;;
        --flash) MODE=--flash ;;
        --no-backup) NO_BACKUP=1 ;;
        --backup-dir)
            shift
            [ "$#" -gt 0 ] || fail "--backup-dir requires a directory"
            BACKUP_ROOT="$1"
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*) fail "unknown option: $1" ;;
        *) break ;;
    esac
    shift
done

[ "$#" -eq 2 ] || {
    usage
    exit 1
}

HELPER=/system/bin/twrp-flash-controlled-stack
[ -x "$HELPER" ] || fail "controlled-stack helper is unavailable: $HELPER"

if [ "$NO_BACKUP" -eq 1 ]; then
    exec "$HELPER" "$MODE" --no-backup --backup-dir "$BACKUP_ROOT" \
        --boot "$1" --system-dlkm "$2"
fi

exec "$HELPER" "$MODE" --backup-dir "$BACKUP_ROOT" \
    --boot "$1" --system-dlkm "$2"
