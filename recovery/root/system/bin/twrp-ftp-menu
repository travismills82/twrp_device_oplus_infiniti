#!/system/bin/sh
# Interactive FTP/FTPS backup menu for TWRP Terminal.
#
# Config file format:
#   name|ftp_or_ftps_directory_url|username|password
#
# Default config path:
#   /sdcard/TWRP/ftp.conf
#
# The config stores credentials as plain text. Use a dedicated FTP account with
# limited permissions and prefer FTPS when the server supports it.

set -u

CONF="${TWRP_FTP_CONF:-/sdcard/TWRP/ftp.conf}"
CURL="${TWRP_CURL_WRAPPER:-/system/bin/twrp-curl}"
BACKUP_HELPER="${TWRP_FTP_BACKUP:-/system/bin/twrp-ftp-backup}"
RESTORE_HELPER="${TWRP_FTP_RESTORE:-/system/bin/twrp-ftp-restore}"
INCOMING_DIR="${TWRP_RESTORE_INCOMING:-/sdcard/TWRP/restore-incoming}"
TMP_DIR="/tmp/twrp-ftp-menu"
ACTIVE_NAME=""
ACTIVE_URL=""
ACTIVE_USER=""
ACTIVE_PASS=""

mkdir -p "$TMP_DIR" 2>/dev/null || true

pause() {
    echo
    echo "Press Enter to continue..."
    read _ans
}

say() {
    echo "twrp-ftp-menu: $*"
}

warn_plaintext() {
    echo
    echo "WARNING: $CONF stores FTP/FTPS server entries and passwords as plain text."
    echo "Use a dedicated backup account with limited folder permissions."
    echo "Prefer ftps:// when the server supports it."
    echo
}

ensure_conf() {
    DIR="${CONF%/*}"
    [ "$DIR" = "$CONF" ] && DIR="."
    mkdir -p "$DIR" 2>/dev/null || true
    [ -f "$CONF" ] || touch "$CONF" 2>/dev/null || true
    chmod 0600 "$CONF" 2>/dev/null || true
}

normalize_dir_url() {
    URL="$1"
    case "$URL" in
        ftp://*|ftps://*) ;;
        *)
            echo ""
            return
            ;;
    esac
    case "$URL" in
        */) echo "${URL%/}" ;;
        *) echo "$URL" ;;
    esac
}

join_url() {
    BASE="$1"
    FILE="$2"
    case "$BASE" in
        */) echo "${BASE}${FILE}" ;;
        *) echo "${BASE}/${FILE}" ;;
    esac
}

load_entry_by_number() {
    NUM="$1"
    COUNT=0
    while IFS='|' read -r NAME URL USER PASS EXTRA; do
        [ -n "${NAME:-}" ] || continue
        case "$NAME" in \#*) continue ;; esac
        COUNT=$((COUNT + 1))
        if [ "$COUNT" = "$NUM" ]; then
            ACTIVE_NAME="$NAME"
            ACTIVE_URL="$URL"
            ACTIVE_USER="$USER"
            ACTIVE_PASS="$PASS"
            return 0
        fi
    done < "$CONF"
    return 1
}

show_active() {
    if [ -n "$ACTIVE_NAME" ]; then
        echo "Active server: $ACTIVE_NAME ($ACTIVE_URL)"
    else
        echo "Active server: none selected"
    fi
}

list_servers() {
    ensure_conf
    echo
    echo "Saved FTP/FTPS servers in $CONF:"
    COUNT=0
    while IFS='|' read -r NAME URL USER PASS EXTRA; do
        [ -n "${NAME:-}" ] || continue
        case "$NAME" in \#*) continue ;; esac
        COUNT=$((COUNT + 1))
        echo "  $COUNT) $NAME  $URL  user=$USER"
    done < "$CONF"
    [ "$COUNT" -gt 0 ] || echo "  none"
}

add_server() {
    ensure_conf
    warn_plaintext

    echo "Server name, for example: home-ftp"
    read NAME
    [ -n "$NAME" ] || { say "server name required"; return; }
    case "$NAME" in *'|'*) say "server name cannot contain |"; return ;; esac

    echo "FTP/FTPS directory URL, for example: ftp://192.168.3.10:21/twrp"
    read URL
    URL="$(normalize_dir_url "$URL")"
    [ -n "$URL" ] || { say "URL must start with ftp:// or ftps://"; return; }
    case "$URL" in *'|'*) say "URL cannot contain |"; return ;; esac

    echo "Username:"
    read USER
    [ -n "$USER" ] || { say "username required"; return; }
    case "$USER" in *'|'*) say "username cannot contain |"; return ;; esac

    echo "Password. Input will be visible in TWRP Terminal:"
    read PASS
    case "$PASS" in *'|'*) say "password cannot contain |"; return ;; esac

    echo "Save this server to $CONF? Type YES to confirm:"
    read OK
    [ "$OK" = "YES" ] || { say "not saved"; return; }

    printf '%s|%s|%s|%s\n' "$NAME" "$URL" "$USER" "$PASS" >> "$CONF"
    chmod 0600 "$CONF" 2>/dev/null || true

    ACTIVE_NAME="$NAME"
    ACTIVE_URL="$URL"
    ACTIVE_USER="$USER"
    ACTIVE_PASS="$PASS"
    say "saved and selected: $ACTIVE_NAME"
}

select_server() {
    ensure_conf
    list_servers
    echo
    echo "Select server number:"
    read NUM
    case "$NUM" in ''|*[!0-9]*) say "invalid number"; return ;; esac
    if load_entry_by_number "$NUM"; then
        say "selected: $ACTIVE_NAME"
    else
        say "server not found"
    fi
}

require_server() {
    [ -n "$ACTIVE_URL" ] || { say "select or add a server first"; return 1; }
    return 0
}

remote_list() {
    require_server || return
    echo
    say "listing $ACTIVE_URL"
    "$CURL" --fail --show-error --connect-timeout 30 --user "$ACTIVE_USER:$ACTIVE_PASS" --list-only "$ACTIVE_URL/"
}

remote_archive_list() {
    require_server || return 1

    RAW_LIST="$TMP_DIR/remote-list.txt"
    ARCHIVE_LIST="$TMP_DIR/remote-archives.txt"
    rm -f "$RAW_LIST" "$ARCHIVE_LIST"

    "$CURL" --fail --show-error --connect-timeout 30 --user "$ACTIVE_USER:$ACTIVE_PASS" --list-only "$ACTIVE_URL/" > "$RAW_LIST" || return 1

    sed 's/\r$//' "$RAW_LIST" | while IFS= read -r LINE; do
        FILE="${LINE##*/}"
        case "$FILE" in
            *.tar|*.tar.gz|*.tgz) echo "$FILE" ;;
        esac
    done > "$ARCHIVE_LIST"

    [ -s "$ARCHIVE_LIST" ] || return 2

    COUNT=0
    while IFS= read -r FILE; do
        COUNT=$((COUNT + 1))
        echo "  $COUNT) $FILE"
    done < "$ARCHIVE_LIST"

    return 0
}

test_connection() {
    require_server || return
    SERIAL="$(getprop ro.serialno 2>/dev/null || echo unknown-serial)"
    TEST_FILE=".twrp-ftp-test-$SERIAL.txt"
    TEST_LOCAL="/tmp/$TEST_FILE"
    TEST_DOWN="/tmp/$TEST_FILE.down"
    TEST_URL="$(join_url "$ACTIVE_URL" "$TEST_FILE")"

    echo "TWRP FTP test from $SERIAL" > "$TEST_LOCAL"

    say "testing directory listing"
    "$CURL" --fail --show-error --connect-timeout 30 --user "$ACTIVE_USER:$ACTIVE_PASS" --list-only "$ACTIVE_URL/" || return

    say "testing upload"
    "$CURL" --fail --show-error --connect-timeout 30 --ftp-create-dirs --user "$ACTIVE_USER:$ACTIVE_PASS" --upload-file "$TEST_LOCAL" "$TEST_URL" || return

    say "testing download"
    "$CURL" --fail --show-error --connect-timeout 30 --user "$ACTIVE_USER:$ACTIVE_PASS" --output "$TEST_DOWN" "$TEST_URL" || return

    echo
    say "FTP/FTPS test passed"
    cat "$TEST_DOWN" 2>/dev/null || true
}

run_backup() {
    require_server || return
    [ -x "$BACKUP_HELPER" ] || { say "missing backup helper: $BACKUP_HELPER"; return; }
    echo "Backup options:"
    echo "  1) Newest backup folder"
    echo "  2) Specific backup folder"
    echo "  3) Custom remote archive name"
    read CHOICE
    case "$CHOICE" in
        2)
            echo "Backup folder name:"
            read BNAME
            [ -n "$BNAME" ] || { say "backup folder required"; return; }
            "$BACKUP_HELPER" --backup "$BNAME" "$ACTIVE_URL" "$ACTIVE_USER" "$ACTIVE_PASS"
            ;;
        3)
            echo "Remote archive name, for example oneplus15-backup.tar:"
            read RNAME
            [ -n "$RNAME" ] || { say "remote filename required"; return; }
            "$BACKUP_HELPER" --remote-name "$RNAME" "$ACTIVE_URL" "$ACTIVE_USER" "$ACTIVE_PASS"
            ;;
        *)
            "$BACKUP_HELPER" "$ACTIVE_URL" "$ACTIVE_USER" "$ACTIVE_PASS"
            ;;
    esac
}

run_restore() {
    require_server || return
    [ -x "$RESTORE_HELPER" ] || { say "missing restore helper: $RESTORE_HELPER"; return; }

    echo "Remote backup archives:"
    echo
    remote_archive_list
    RC="$?"

    if [ "$RC" = "1" ]; then
        say "failed to list remote folder"
        return
    fi

    if [ "$RC" = "2" ]; then
        say "no .tar, .tar.gz, or .tgz backup archives found in $ACTIVE_URL"
        echo "Type m at the next prompt to enter a filename manually."
    fi

    echo
    echo "Select archive number to restore, or type m for manual filename:"
    read RSEL

    case "$RSEL" in
        m|M)
            echo "Remote backup archive filename or full ftp:// / ftps:// URL:"
            read RFILE
            [ -n "$RFILE" ] || { say "remote filename required"; return; }
            case "$RFILE" in
                ftp://*|ftps://*)
                    RURL="$RFILE"
                    URL_NO_QUERY="${RFILE%%\?*}"
                    ARCHIVE_NAME="${URL_NO_QUERY##*/}"
                    ;;
                *)
                    ARCHIVE_NAME="${RFILE##*/}"
                    RURL="$(join_url "$ACTIVE_URL" "$ARCHIVE_NAME")"
                    ;;
            esac
            ;;
        ''|*[!0-9]*)
            say "invalid selection"
            return
            ;;
        *)
            RFILE="$(sed -n "${RSEL}p" "$TMP_DIR/remote-archives.txt" 2>/dev/null || true)"
            [ -n "$RFILE" ] || { say "archive not found"; return; }
            ARCHIVE_NAME="${RFILE##*/}"
            RURL="$(join_url "$ACTIVE_URL" "$ARCHIVE_NAME")"
            ;;
    esac

    [ -n "$ARCHIVE_NAME" ] || ARCHIVE_NAME="backup.tar"
    LOCAL_ARCHIVE="$INCOMING_DIR/$ARCHIVE_NAME"

    echo
    echo "Restore archive selected:"
    echo "  Source : $RURL"
    echo "  Target : $LOCAL_ARCHIVE"
    echo
    echo "Continue restore? Type YES to continue:"
    read OK
    [ "$OK" = "YES" ] || { say "restore cancelled"; return; }

    mkdir -p "$INCOMING_DIR" 2>/dev/null || true
    "$RESTORE_HELPER" --archive "$LOCAL_ARCHIVE" "$RURL" "$ACTIVE_USER" "$ACTIVE_PASS"
}

upload_logs() {
    require_server || return
    SERIAL="$(getprop ro.serialno 2>/dev/null || echo unknown-serial)"
    TS="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo now)"
    OUT="/tmp/twrp-log-$SERIAL-$TS.txt"
    RURL="$(join_url "$ACTIVE_URL" "twrp-log-$SERIAL-$TS.txt")"

    {
        echo "===== curl version ====="
        "$CURL" --version 2>&1
        echo
        echo "===== ifconfig ====="
        ifconfig 2>&1
        echo
        echo "===== route ====="
        route -n 2>&1
        echo
        echo "===== recovery.log ====="
        cat /tmp/recovery.log 2>&1
    } > "$OUT"

    "$CURL" --fail --show-error --connect-timeout 30 --ftp-create-dirs --user "$ACTIVE_USER:$ACTIVE_PASS" --upload-file "$OUT" "$RURL"
}

net_info() {
    echo "===== active server ====="
    show_active
    echo
    echo "===== ifconfig ====="
    ifconfig 2>/dev/null || ip addr 2>/dev/null
    echo
    echo "===== route ====="
    route -n 2>/dev/null || ip route 2>/dev/null
    echo
    echo "===== wlan0 status ====="
    wpa_cli -p /data/vendor/wifi/wpa/sockets -i wlan0 status 2>/dev/null || wpa_cli -i wlan0 status 2>/dev/null || true
    echo
    echo "===== curl ====="
    "$CURL" --version 2>/dev/null || true
}

delete_config() {
    echo "Delete $CONF? Type DELETE to confirm:"
    read OK
    [ "$OK" = "DELETE" ] || { say "not deleted"; return; }
    rm -f "$CONF"
    ACTIVE_NAME=""
    ACTIVE_URL=""
    ACTIVE_USER=""
    ACTIVE_PASS=""
    say "deleted config"
}

main_menu() {
    ensure_conf
    while true; do
        echo
        echo "TWRP FTP/FTPS Wireless Backup Menu"
        echo "==================================="
        show_active
        echo
        echo "1) Add FTP/FTPS server to ftp.conf"
        echo "2) Select FTP/FTPS server from ftp.conf"
        echo "3) Test selected server"
        echo "4) Upload newest TWRP backup"
        echo "5) List remote backup folder"
        echo "6) Restore backup archive"
        echo "7) Upload recovery log and network info"
        echo "8) Show network info"
        echo "9) Delete ftp.conf"
        echo "0) Exit"
        echo
        echo "Choice:"
        read CHOICE
        case "$CHOICE" in
            1) add_server; pause ;;
            2) select_server; pause ;;
            3) test_connection; pause ;;
            4) run_backup; pause ;;
            5) remote_list; pause ;;
            6) run_restore; pause ;;
            7) upload_logs; pause ;;
            8) net_info; pause ;;
            9) delete_config; pause ;;
            0) exit 0 ;;
            *) say "invalid choice"; pause ;;
        esac
    done
}

main_menu
