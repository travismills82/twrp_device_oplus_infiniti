#!/system/bin/sh
#
# Patch and flash the active boot/init_boot partition with bundled Magisk.
# Intended for use from TWRP Advanced menu or terminal.
#
# Usage:
#   twrp-flash-magisk [boot|init_boot]
#

set -e

PARTITION="${1:-boot}"
OUTDIR="/sdcard/TWRP/root-patcher"
MAGISK_APK="/system/etc/magisk/Magisk.apk"

ui_print() {
    echo "[magisk-flash] $1"
}

fail() {
    ui_print "ERROR: $1"
    exit 1
}

find_partition() {
    name="$1"
    slot="$(getprop ro.boot.slot_suffix 2>/dev/null || true)"

    for candidate in \
        "/dev/block/by-name/${name}${slot}" \
        "/dev/block/by-name/${name}" \
        "/dev/block/bootdevice/by-name/${name}${slot}" \
        "/dev/block/bootdevice/by-name/${name}"; do
        if [ -e "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    return 1
}

get_size_bytes() {
    file="$1"
    wc -c < "$file" 2>/dev/null | tr -d ' '
}

case "$PARTITION" in
    boot|init_boot) ;;
    *) fail "unsupported partition: $PARTITION; use boot or init_boot" ;;
esac

[ -f "$MAGISK_APK" ] || fail "bundled Magisk APK not found at $MAGISK_APK"
command -v twrp-root-patcher >/dev/null 2>&1 || fail "twrp-root-patcher not found"

BLOCK="$(find_partition "$PARTITION")" || fail "could not find ${PARTITION} block device"
SLOT="$(getprop ro.boot.slot_suffix 2>/dev/null || true)"

ui_print "Target partition: $PARTITION"
ui_print "Active slot suffix: ${SLOT:-none}"
ui_print "Target block: $BLOCK"
ui_print "Running Magisk patcher"

twrp-root-patcher magisk "$MAGISK_APK" "$PARTITION"

PATCHED="${OUTDIR}/${PARTITION}-magisk-patched.img"
STOCK="${OUTDIR}/${PARTITION}-stock.img"

[ -f "$PATCHED" ] || fail "patched image not found: $PATCHED"
[ -r "$PATCHED" ] || fail "patched image is not readable: $PATCHED"
[ -s "$PATCHED" ] || fail "patched image is empty: $PATCHED"
[ -f "$STOCK" ] || fail "stock backup not found: $STOCK"
[ -r "$STOCK" ] || fail "stock backup is not readable: $STOCK"
[ -s "$STOCK" ] || fail "stock backup is empty: $STOCK"

PATCHED_SIZE="$(get_size_bytes "$PATCHED")"
STOCK_SIZE="$(get_size_bytes "$STOCK")"

case "$PATCHED_SIZE" in
    ''|*[!0-9]*) fail "could not determine patched image size" ;;
esac

case "$STOCK_SIZE" in
    ''|*[!0-9]*) fail "could not determine stock image size" ;;
esac

MIN_SIZE=$((STOCK_SIZE / 2))
MAX_SIZE=$((STOCK_SIZE + (STOCK_SIZE / 2)))

ui_print "Stock image size: ${STOCK_SIZE} bytes"
ui_print "Patched image size: ${PATCHED_SIZE} bytes"

[ "$PATCHED_SIZE" -ge "$MIN_SIZE" ] || fail "patched image is unexpectedly small"
[ "$PATCHED_SIZE" -le "$MAX_SIZE" ] || fail "patched image is unexpectedly large"

ui_print "Saving checksum"
sha256sum "$PATCHED" > "${PATCHED}.sha256" 2>/dev/null || true

ui_print "Flashing patched image to $BLOCK"
dd if="$PATCHED" of="$BLOCK" bs=4M
sync

ui_print "Magisk flash complete"
ui_print "Stock backup: $STOCK"
ui_print "Patched image: $PATCHED"
ui_print "Reboot to system when ready."
