#!/system/bin/sh
# Wait until wpa_supplicant responds before exposing Wi-Fi as ready to TWRP.
# TWRP's WLAN page should only scan after wifi.driver.ready=true.

SOCKET_DIR="/tmp/recovery/sockets"
ALT_SOCKET_DIR="/data/misc/wifi/sockets"
IFACE="wlan0"

ui_print() {
    echo "[wifi-ready] $1"
    echo "[wifi-ready] $1" > /dev/kmsg 2>/dev/null || true
}

fail() {
    ui_print "ERROR: $1"
    setprop wifi.driver.ready false 2>/dev/null || true
    setprop twrp.wifi.status supplicant-error 2>/dev/null || true
    exit 0
}

prepare_socket_dirs() {
    mkdir -p /tmp/recovery 2>/dev/null || true
    mkdir -p /data/misc/wifi/sockets 2>/dev/null || true
    chmod 0777 /tmp/recovery 2>/dev/null || true
    chmod 0770 /data/misc 2>/dev/null || true
    chmod 0770 /data/misc/wifi 2>/dev/null || true
    chmod 0770 /data/misc/wifi/sockets 2>/dev/null || true

    # wpa_supplicant is started with -O/data/misc/wifi/sockets, while TWRP
    # and manual terminal commands commonly use /tmp/recovery/sockets.
    # Always expose the same control directory at both paths before readiness.
    if [ -e "$SOCKET_DIR" ] && [ ! -L "$SOCKET_DIR" ]; then
        rm -rf "$SOCKET_DIR" 2>/dev/null || true
    fi

    if [ ! -e "$SOCKET_DIR" ]; then
        ln -s "$ALT_SOCKET_DIR" "$SOCKET_DIR" 2>/dev/null || true
    fi
}

wait_for_socket() {
    count=0
    while [ "$count" -lt 30 ]; do
        if [ -S "$SOCKET_DIR/$IFACE" ] || [ -S "$ALT_SOCKET_DIR/$IFACE" ]; then
            ui_print "supplicant control socket detected"
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    fail "supplicant control socket did not appear"
}

wait_for_pong() {
    count=0
    while [ "$count" -lt 30 ]; do
        if wpa_cli -i "$IFACE" -p "$SOCKET_DIR" ping 2>/tmp/twrp-wifi-wpa-cli.err | grep -q PONG; then
            ui_print "wpa_cli ping returned PONG"
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    fail "wpa_cli ping did not return PONG"
}

setprop wifi.driver.ready false 2>/dev/null || true
setprop twrp.wifi.status waiting-supplicant 2>/dev/null || true

prepare_socket_dirs
wait_for_socket
wait_for_pong

setprop wifi.driver.ready true 2>/dev/null || true
setprop twrp.wifi.status ready 2>/dev/null || true
ui_print "Wi-Fi supplicant is ready"
exit 0
